@{
    ViewBag.Title = "Actualización de datos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Estilos limpios combinados con el botón futurista -->
<style>
    /* Título elegante y sobrio */
    .clean-title {
        letter-spacing: 0.5px;
        font-size: 26px;
        color: #333333;
        text-transform: uppercase;
        position: relative;
        display: inline-block;
    }

        .clean-title::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 0;
            width: 100%;
            height: 3px;
            background-color: #0d6efd;
            border-radius: 2px;
        }

    /* Tarjeta de alerta clara con texto en negro semitransparente/oscuro legible */
    .clean-alert {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-left: 4px solid #0d6efd !important;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    /* --- BOTÓN EN MODO FUTURISTA --- */
    .btn-futuristic {
        background-color: #121820;
        color: #00f2ff;
        border: 1px solid #00f2ff;
        border-radius: 8px;
        font-family: 'Courier New', Courier, monospace;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        box-shadow: 0 0 10px rgba(0, 242, 255, 0.2);
    }

        .btn-futuristic:hover {
            background-color: #00f2ff;
            color: #121820;
            box-shadow: 0 0 20px rgba(0, 242, 255, 0.6);
        }
</style>

@using (Html.BeginForm("Datos", "ActualizaMatrClienCiud", FormMethod.Post, new { id = "registerForm", enctype = "multipart/form-data" }))
{
    <!-- Título principal -->
    <div class="row justify-content-center">
        <div class="col-12 text-center my-4">
            <h2 class="fw-bold clean-title">
                Actualización de Matrículas, Ciudades y Clientes
            </h2>
        </div>
    </div>

    <!-- Tarjeta de Aviso con fondo claro y texto oscuro legible -->
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="clean-alert p-4 my-3" role="alert">
                <div class="d-flex align-items-start">
                    <div class="me-3 fs-4 text-primary">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>
                    <div>
                        <span class="d-block fw-bold text-dark mb-2" style="font-size: 15px;">Aviso Importante</span>
                        <p class="mb-0 text-dark" style="text-align: justify; font-size: 15px; line-height: 1.6; opacity: 0.85;">
                            Al continuar con el proceso de actualización de datos del sistema integrado al nuevo sistema de autorizaciones, por favor una vez terminado el proceso debe revisar en el sistema de autorizaciones si se realizó la actualización correcta.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Botón Procesar en Estilo Futurista -->
    <div class="row justify-content-center my-4">
        <div class="col-12 text-center">
            <button type="button" class="btn btn-futuristic px-5 py-2 fw-bold" onclick="Consultar()" style="font-size: 16px;">
                <i class="bi bi-cpu me-2"></i> PROCESAR
            </button>
        </div>
    </div>
}

@section scripts{
    <script>
        function Consultar() {
            Swal.fire({
                title: 'Procesando...',
                text: 'Por favor espere mientras se realiza la actualización de datos.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: $.MisUrls.url._ActualizaDatosMatrCliCiud,
                type: "GET",
                contentType: "application/json;charset=UTF-8",
                dataType: "json",
                data: {},
                success: function (e) {
                    if (e && e.Success) {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Éxito!',
                            text: e.Message || 'El proceso se ejecutó correctamente.',
                            confirmButtonText: 'Aceptar'
                        });
                    } else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Atención',
                            text: (e && e.Message) ? e.Message : 'No se pudo realizar la actualización de los datos.',
                            confirmButtonText: 'Aceptar'
                        });
                    }
                },
                error: function (errormessage) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error de Conexión',
                        text: "Ocurrió un error al procesar la solicitud en el servidor.",
                        confirmButtonText: 'Aceptar'
                    });
                }
            });
        }
    </script>
}