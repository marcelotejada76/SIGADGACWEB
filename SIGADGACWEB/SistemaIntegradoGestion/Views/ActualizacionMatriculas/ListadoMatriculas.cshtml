@model IEnumerable<CapaModelo.tbActualizacionMatriculas>
@{
    ViewBag.Title = "Listado de Matrículas HC";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totalMatriculas = Model != null ? Model.Count() : 0;
}

<style>
    .table-executive thead th {
        background-color: #1a2226;
        color: #ffffff;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: none;
        padding: 12px 15px;
    }
    .table-executive tbody td {
        vertical-align: middle;
        padding: 12px 15px;
        font-size: 0.9rem;
    }
</style>

<div class="container-fluid pt-3">

    <!-- Header Principal -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="mb-2 mb-md-0">
            <h2 class="font-weight-bold text-dark mb-1" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                <i class="fas fa-plane-departure text-primary mr-2"></i> Listado de Matrículas HC
            </h2>
            <p class="text-muted mb-0 small">
                Consulta y gestión de historial y actualización de matrículas
            </p>
        </div>
    </div>

    <!-- Search Form Card -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-body p-3">
            @using (Html.BeginForm("ListadoMatriculas", "ActualizacionMatriculas", FormMethod.Post, new { id = "registerForm", enctype = "multipart/form-data" }))
            {
                <div class="row align-items-center">
                    <div class="col-md-3 col-sm-12 mb-2 mb-md-0">
                        <label class="font-weight-bold text-muted small text-uppercase mb-0">
                            <i class="fas fa-search mr-1"></i> Búsqueda por Matrícula
                        </label>
                    </div>
                    <div class="col-md-6 col-sm-12 mb-2 mb-md-0">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-light border-right-0"><i class="fas fa-plane text-muted"></i></span>
                            </div>
                            <input type="text" name="Matricula" id="Matricula" class="form-control border-left-0" style="text-transform:uppercase" placeholder="Ingrese Matrícula..." />
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-12 text-md-right">
                        <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm font-weight-bold">
                            <i class="fas fa-search mr-1"></i> Buscar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main Table Executive Card -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="card-title m-0 font-weight-bold text-dark" style="font-size: 1.05rem;">
                <i class="fas fa-list-ul text-primary mr-2"></i> Listado Registrado de Matrículas HC
            </h5>
            <span class="badge badge-light border px-3 py-2 font-weight-normal" style="border-radius: 20px;">
                <i class="fas fa-layer-group text-primary mr-1"></i> @totalMatriculas Registros
            </span>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="tbDetalle" class="table table-hover table-striped table-executive w-100">
                    <thead>
                        <tr>
                            <th><i class="fas fa-plane mr-1"></i> Matrícula</th>
                            <th><i class="fas fa-weight-hanging mr-1"></i> Peso Max Estructural</th>
                            <th><i class="fas fa-map-marker-alt mr-1"></i> Región</th>
                            <th class="text-center"><i class="fas fa-cogs mr-1"></i> Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="font-weight-bold text-dark">
                                    <span class="badge badge-light border text-primary font-weight-bold px-2 py-1" style="font-size:0.9rem">
                                        <i class="fas fa-plane-departure mr-1"></i> @Html.DisplayFor(modelItem => item.MATRICULA)
                                    </span>
                                </td>
                                <td class="font-weight-bold text-dark">@Html.DisplayFor(modelItem => item.PESOMAXESTRUCTURAL)</td>
                                <td>
                                    <span class="badge bg-info text-white px-2 py-1 font-weight-bold">
                                        @Html.DisplayFor(modelItem => item.REGION)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a class="btn btn-sm btn-outline-primary px-3 rounded-pill shadow-sm font-weight-bold" href="@Url.Action("DetalleMatricula", "ActualizacionMatriculas", new { Matricula = item.MATRICULA })">
                                        <i class="fas fa-search mr-1"></i> Ver Detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            if ($.fn.dataTable.isDataTable('#tbDetalle')) {
                $('#tbDetalle').DataTable().destroy();
            }

            $('#tbDetalle').DataTable({
                "responsive": true,
                "autoWidth": false,
                "pageLength": 10,
                "language": {
                    "sProcessing":     "Procesando...",
                    "sLengthMenu":     "Mostrar _MENU_ registros",
                    "sZeroRecords":    "No se encontraron resultados",
                    "sEmptyTable":     "Ningún dato disponible en esta tabla",
                    "sInfo":           "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                    "sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
                    "sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
                    "sSearch":         "Buscar:",
                    "oPaginate": {
                        "sFirst":    "Primero",
                        "sLast":     "Último",
                        "sNext":     "Siguiente",
                        "sPrevious": "Anterior"
                    }
                }
            });
        });
    </script>
}
