@model IEnumerable<CapaModelo.tbAeronavesComponentes>
@{
    ViewBag.Title = "ListadoMatriculas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .section-title {
        background-color: #f1f3f5;
        font-weight: 600;
        font-size: 14px;
        padding: 8px;
        border-left: 4px solid #0d6efd;
        margin-top: 25px;
        text-transform: uppercase;
        color: #212529;
    }

    .field-label {
        font-size: 12px;
        font-weight: 600;
        color: #495057;
        margin-bottom: 3px;
    }

    .form-control-sm {
        background-color: #f8f9fa;
    }

    .card-dgac {
        border: 1px solid #dee2e6;
        padding: 20px;
        margin-bottom: 20px;
        border-radius: 6px;
        background-color: #ffffff;
    }

    .table-dgac {
        font-size: 12px;
        border: 1px solid #dee2e6;
    }

        .table-dgac thead {
            background-color: #0d3b66;
            color: #ffffff;
            text-align: center;
            font-weight: 600;
            font-size: 12px;
        }

        .table-dgac tbody tr:hover {
            background-color: #f2f4f6;
        }

        .table-dgac td {
            vertical-align: middle;
            text-align: center;
        }

        .table-dgac th {
            vertical-align: middle;
        }
    .estado-activo {
        background-color: #198754 !important; /* verde institucional */
        color: #ffffff;
        font-weight: 600;
        text-align: center;
        border-radius: 4px;
        padding: 4px 8px;
        display: inline-block;
        min-width: 80px;
    }

    .estado-inactivo {
        background-color: #dc3545;
        color: #ffffff;
        font-weight: 600;
        text-align: center;
        border-radius: 4px;
        padding: 4px 8px;
        display: inline-block;
        min-width: 80px;
    }
    .btn-dgac {
        background-color: #0d3b66;
        color: #ffffff;
        border: none;
    }

        .btn-dgac:hover {
            background-color: #0b2f52;
            color: #ffffff;
        }
</style>

<div class="container-fluid">
    <!--begin::Container-->
    <div class="card-header card-header-stretch mb-3">
        <div class="card-title">
            <p class="text-blue">Listado Matriculas HC</p>
        </div>
    </div>
    @using (Html.BeginForm("ListadoMatriculas", "AeronaveComponente", FormMethod.Post, new { id = "registerForm", enctype = "multipart/form-data" }))
    {
        <div class="row align-items-end mb-4">

            <div class="col-sm-3">
                <label class="material-label">Matricula</label>
                <input type="text" name="Matricula" id="Matricula" class="form-control material-input" />
            </div>
            <div class="col-sm-2">
                <button type="submit" class="btn btn-modern btn-success">
                    🔍 Buscar
                </button>
            </div>
        </div>
        <div class="card card-default">
            <div class="card-body">
                <div class="row">
                    <table id="tbDetalle" class="table table-bordered table-hover table-sm" style="width:100%">
                        <thead>
                            <tr>
                                <th>Matricula</th>
                                <th>CodigoOaci</th>
                                <th>Marca</th>
                                <th>Modelo</th>

                                <th class=" control-label control-lab"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.AERONAVE)</td>
                                    <td>@Html.DisplayFor(modelItem => item.CODIFOOACI)</td>
                                    <td>@Html.DisplayFor(modelItem => item.MARCA)</td>
                                    <td>@Html.DisplayFor(modelItem => item.MODELO)</td>


                                    <td>
                                        <a id="Consultar" class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                                           href="#"
                                           onclick="Consultar('@item.AERONAVE')">
                                            <i class="bi bi-search"></i> Consulta
                                        </a>

                                    </td>
                                    @*<td>
                                            <a id="Consultar" href="@Url.Action("CargaDetalleAeronave", "AeronaveComponente", new {Matricula=item.AERONAVE })">
                                                <i>
                                                    <img src="~/Content/imganes/consultar-documento.png" style="width:15px" />

                                                </i>
                                                Consulta
                                            </a>
                                        </td>*@
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    }
</div>

