@model IEnumerable<CapaModelo.tbBancoRuminahui>
@{
    ViewBag.Title = "Listado Banco Rumiñahui";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totalRegistros = Model != null ? Model.Count() : 0;
}

<style>
    .badge-pill-custom {
        padding: 0.5em 0.85em;
        font-size: 0.82rem;
        font-weight: 600;
        border-radius: 50rem;
    }
    .table-executive thead th {
        background-color: #1a2226;
        color: #ffffff;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: none;
        padding: 12px 15px;
    }
    .table-executive tbody td {
        vertical-align: middle;
        padding: 12px 15px;
        font-size: 0.9rem;
    }
    .detail-modal-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #6c757d;
        letter-spacing: 0.5px;
        margin-bottom: 0.25rem;
    }
    .receipt-header {
        background-color: #f8fbfd;
        padding: 1.25rem;
        border-bottom: 2px dashed #dee2e6;
    }
    .receipt-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 0.2rem;
        display: block;
    }
    .receipt-value {
        font-size: 1rem;
        font-weight: 600;
        color: #2c3e50;
        display: block;
        margin-bottom: 0.75rem;
        word-break: break-word;
    }
    .receipt-total-section {
        background-color: #f4f7fa;
        padding: 1.25rem;
        border-top: 2px solid #0f4c81;
        border-radius: 0 0 12px 12px;
    }
    .total-label {
        font-size: 1.05rem;
        font-weight: 700;
        color: #2c3e50;
    }
    .total-value {
        font-size: 1.3rem;
        font-weight: 800;
        color: #0f4c81;
        text-align: right;
    }
    .diferencia-value {
        font-size: 1.15rem;
        font-weight: 800;
        text-align: right;
    }
    .diferencia-zero {
        color: #28a745;
    }
    .diferencia-alert {
        color: #dc3545;
    }
</style>

<div class="container-fluid pt-3">

    <!-- Header Principal -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="mb-2 mb-md-0">
            <h2 class="font-weight-bold text-dark mb-1" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                <i class="fas fa-university text-primary mr-2"></i> Depósitos Banco Rumiñahui
            </h2>
            <p class="text-muted mb-0 small">
                Monitoreo y consulta consolidada de depósitos bancarios del Banco Rumiñahui
            </p>
        </div>
    </div>

    <!-- Search Form Card -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-body p-3">
            @using (Html.BeginForm("ListadoBancoRuminahui", "BancoRuminahui", FormMethod.Post, new { id = "registerForm", enctype = "multipart/form-data" }))
            {
                <div class="row align-items-center">
                    <div class="col-md-3 col-sm-12 mb-2 mb-md-0">
                        <label class="font-weight-bold text-muted small text-uppercase mb-0">
                            <i class="fas fa-search mr-1"></i> Búsqueda por Depósito
                        </label>
                    </div>
                    <div class="col-md-6 col-sm-12 mb-2 mb-md-0">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-light border-right-0"><i class="fas fa-search text-muted"></i></span>
                            </div>
                            <input type="text" style="text-transform:uppercase" class="form-control border-left-0" id="Comprobante" name="Comprobante" placeholder="Ingrese comprobante, fecha o depositante..." />
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-12 text-md-right">
                        <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm font-weight-bold">
                            <i class="fas fa-search mr-1"></i> Buscar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main Table Executive Card -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="card-title m-0 font-weight-bold text-dark" style="font-size: 1.05rem;">
                <i class="fas fa-list-ul text-primary mr-2"></i> Listado Registrado de Depósitos
            </h5>
            <span class="badge badge-light border px-3 py-2 font-weight-normal" style="border-radius: 20px;">
                <i class="fas fa-layer-group text-primary mr-1"></i> @totalRegistros Registros
            </span>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="tbDetalle" class="table table-hover table-striped table-executive w-100">
                    <thead>
                        <tr>
                            <th><i class="fas fa-calendar-alt mr-1"></i> Fecha Proceso</th>
                            <th><i class="fas fa-hashtag mr-1"></i> No. Comprobante</th>
                            <th><i class="fas fa-calendar-day mr-1"></i> Fecha Bco. Central</th>
                            <th><i class="fas fa-receipt mr-1"></i> Comp. Bco. Central</th>
                            <th><i class="fas fa-user mr-1"></i> Depositante</th>
                            <th class="text-center"><i class="fas fa-map-marker-alt mr-1"></i> Estación</th>
                            <th class="text-center"><i class="fas fa-info-circle mr-1"></i> Estado</th>
                            <th class="text-right"><i class="fas fa-dollar-sign mr-1"></i> Monto</th>
                            <th class="text-center"><i class="fas fa-cogs mr-1"></i> Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="font-weight-bold text-muted">@Html.DisplayFor(modelItem => item.FECHAPROCESO)</td>
                                    <td class="font-weight-bold text-dark">@Html.DisplayFor(modelItem => item.NUMEROCOMPROBANTE)</td>
                                    <td>@Html.DisplayFor(modelItem => item.FECHABCOCENTRAL)</td>
                                    <td>@Html.DisplayFor(modelItem => item.NUMCOMPBCOCENTRAL)</td>
                                    <td>
                                        <span class="d-inline-block text-truncate" style="max-width: 200px;" title="@item.DEPOSITANTE">
                                            @Html.DisplayFor(modelItem => item.DEPOSITANTE)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.ZONAL == "QUITO")
                                        {
                                            <span class="badge bg-primary text-white badge-pill-custom shadow-sm"><i class="fas fa-map-marker-alt mr-1"></i> @item.ZONAL</span>
                                        }
                                        else if (item.ZONAL == "GUAYAQUIL")
                                        {
                                            <span class="badge bg-success text-white badge-pill-custom shadow-sm"><i class="fas fa-map-marker-alt mr-1"></i> @item.ZONAL</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white badge-pill-custom shadow-sm">@item.ZONAL</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.ESTADO == "P")
                                        {
                                            <span class="badge bg-success text-white badge-pill-custom shadow-sm"><i class="fas fa-clock mr-1"></i> Procesado</span>
                                        }
                                        else if (item.ESTADO == "E")
                                        {
                                            <span class="badge bg-danger text-white badge-pill-custom shadow-sm"><i class="fas fa-check-circle mr-1"></i> Reservado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white badge-pill-custom shadow-sm">@item.ESTADO</span>
                                        }
                                    </td>
                                    <td class="text-right font-weight-bold text-primary">
                                        $@Html.DisplayFor(modelItem => item.MONTO)
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary px-3 rounded-pill shadow-sm font-weight-bold" onclick="Consultar(@item.FECHAPROCESO, '@item.NUMEROCOMPROBANTE')">
                                            <i class="fas fa-search mr-1"></i> Ver Detalle
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Formato Recibo -->
<div class="modal fade" id="largeModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-lg" style="overflow: hidden;">

            <div class="modal-header bg-gradient-primary text-white py-3">
                <h5 class="modal-title font-weight-bold" id="modalLabel">
                    <i class="fas fa-receipt mr-2"></i> Detalle de Depósito DGAC
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body p-0">
                <!-- Información Cabecera del Recibo -->
                <div class="receipt-header">
                    <div class="row">
                        <div class="col-md-3 col-sm-6">
                            <span class="receipt-label">Fecha Proceso</span>
                            <span class="receipt-value" id="lblFECHAPROCESO">-</span>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <span class="receipt-label">No. Comprobante</span>
                            <span class="receipt-value text-primary font-weight-bold" id="lblNUMEROCOMPROBANTE">-</span>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <span class="receipt-label">Estación</span>
                            <span class="receipt-value" id="lblESTACION">-</span>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <span class="receipt-label">Oficina</span>
                            <span class="receipt-value" id="lblOFICINA">-</span>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-6">
                            <span class="receipt-label">Depositante</span>
                            <span class="receipt-value" id="lblDEPOSITANTE">-</span>
                        </div>
                        <div class="col-md-6">
                            <span class="receipt-label">Concepto</span>
                            <span class="receipt-value" id="lblCONCEPTO">-</span>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-4">
                            <span class="receipt-label">Fecha Bco. Central</span>
                            <span class="receipt-value" id="lblFECHABCOCENTRAL">-</span>
                        </div>
                        <div class="col-md-4">
                            <span class="receipt-label">Comp. Bco. Central</span>
                            <span class="receipt-value" id="lblNUMCOMPBCOCENTRAL">-</span>
                        </div>
                        <div class="col-md-4">
                            <span class="receipt-label">Monto Registrado</span>
                            <span class="receipt-value text-primary font-weight-bold" id="lblMONTO">-</span>
                        </div>
                    </div>
                </div>

                <!-- Detalle Comprobantes -->
                <div class="p-4">
                    <h6 class="font-weight-bold text-uppercase mb-3" style="color: #6c757d; font-size: 0.85rem;"><i class="fas fa-list-ul mr-2"></i>Detalle de Facturación Asociada</h6>
                    <div class="table-responsive">
                        <table id="tbDetalleComprobantesDeposito" class="table table-sm table-executive w-100">
                            <thead>
                                <tr>
                                    <th>CÓDIGO</th>
                                    <th>FACTURA</th>
                                    <th>CLIENTE</th>
                                    <th>LUGAR</th>
                                    <th class="text-center">TIPO</th>
                                    <th class="text-right">VALOR</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Rellenado por AJAX -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Totales y Diferencia -->
                <div class="receipt-total-section">
                    <div class="row align-items-center">
                        <div class="col-md-6 text-muted small mb-2 mb-md-0">
                            <i class="fas fa-info-circle mr-1"></i> Los valores mostrados están expresados en USD.
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                <span class="total-label">TOTAL FACTURADO:</span>
                                <span class="total-value" id="lblTOTAL">$ 0.00</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="total-label">DIFERENCIA:</span>
                                <span class="diferencia-value" id="lblDIFERENCIA">$ 0.00</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4 rounded-pill font-weight-bold" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            if ($.fn.dataTable.isDataTable('#tbDetalle')) {
                $('#tbDetalle').DataTable().destroy();
            }

            $('#tbDetalle').DataTable({
                "responsive": true,
                "autoWidth": false,
                "pageLength": 10,
                "language": {
                    "sProcessing":     "Procesando...",
                    "sLengthMenu":     "Mostrar _MENU_ registros",
                    "sZeroRecords":    "No se encontraron resultados",
                    "sEmptyTable":     "Ningún dato disponible en esta tabla",
                    "sInfo":           "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                    "sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
                    "sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
                    "sSearch":         "Buscar:",
                    "oPaginate": {
                        "sFirst":    "Primero",
                        "sLast":     "Último",
                        "sNext":     "Siguiente",
                        "sPrevious": "Anterior"
                    }
                },
                "order": [[0, "desc"]]
            });
        });

        function Consultar(Fechaproceso, Numerocomprobante) {
            $("#lblFECHAPROCESO").text("Cargando...");
            $("#lblNUMEROCOMPROBANTE").text("Cargando...");
            $("#lblESTACION").text("Cargando...");
            $("#lblOFICINA").text("Cargando...");
            $("#lblCONCEPTO").text("Cargando...");
            $("#lblMONTO").text("Cargando...");
            $("#lblDEPOSITANTE").text("Cargando...");
            $("#lblFECHABCOCENTRAL").text("Cargando...");
            $("#lblNUMCOMPBCOCENTRAL").text("Cargando...");
            $("#lblTOTAL").text("$ 0.00");
            $("#lblDIFERENCIA").text("$ 0.00").removeClass('diferencia-alert diferencia-zero');
            $("#tbDetalleComprobantesDeposito tbody").html('<tr><td colspan="6" class="text-center text-muted"><i class="fas fa-spinner fa-spin mr-2"></i> Cargando detalles...</td></tr>');

            $.ajax({
                url: $.MisUrls.url._DetalleBancoRuminahui,
                type: "GET",
                contentType: "application/json;charset=UTF-8",
                dataType: "json",
                data: { FechaDeposito: Fechaproceso, NumeroComprobante: Numerocomprobante },
                success: function (e) {
                    $("#lblFECHAPROCESO").text(e.FECHAPROCESO || "-");
                    $("#lblNUMEROCOMPROBANTE").text(e.NUMEROCOMPROBANTE || "-");
                    $("#lblESTACION").text(e.ZONAL || "-");
                    $("#lblOFICINA").text(e.OFICINA || "-");
                    $("#lblCONCEPTO").text(e.CONCEPTO || "-");
                    $("#lblMONTO").text("$ " + (e.MONTO || "0.00"));
                    $("#lblDEPOSITANTE").text(e.DEPOSITANTE || "-");
                    $("#lblFECHABCOCENTRAL").text(e.FECHABCOCENTRAL || "-");
                    $("#lblNUMCOMPBCOCENTRAL").text(e.NUMCOMPBCOCENTRAL || "-");

                    $("#lblTOTAL").text("$ " + (e.TOTAL || "0.00"));

                    var dif = parseFloat(e.DIFERENCIA || 0);
                    $("#lblDIFERENCIA").text("$ " + dif.toFixed(2));

                    if (dif !== 0) {
                        $("#lblDIFERENCIA").addClass('diferencia-alert');
                    } else {
                        $("#lblDIFERENCIA").addClass('diferencia-zero');
                    }

                    $("#tbDetalleComprobantesDeposito tbody").html("");

                    if (e.oDetalleDeposito && e.oDetalleDeposito.length > 0) {
                        $.each(e.oDetalleDeposito, function (i, row) {
                            $("<tr>").append(
                                $("<td>").text(row["CODIGORECAUDACION"]),
                                $("<td>").text(row["NUMEROFACTURA"]),
                                $("<td>").text(row["CLIENTE"]),
                                $("<td>").text(row["LUGAR"]),
                                $("<td class='text-center'>").html('<span class="badge badge-light border">' + row["TIPO"] + '</span>'),
                                $("<td class='text-right font-weight-bold'>").text("$ " + row["MONTO"])
                            ).appendTo("#tbDetalleComprobantesDeposito tbody");
                        });
                    } else {
                        $("#tbDetalleComprobantesDeposito tbody").html('<tr><td colspan="6" class="text-center text-muted">No hay facturas asociadas a este depósito.</td></tr>');
                    }
                },
                error: function (errormessage) {
                    Swal.fire("Error de Conexión", "No se pudo obtener el detalle: " + errormessage.statusText, "error");
                    $("#tbDetalleComprobantesDeposito tbody").html('<tr><td colspan="6" class="text-center text-danger">Error al cargar datos.</td></tr>');
                }
            });

            $('#largeModal').modal('show');
        }
    </script>
}
