+
@model IEnumerable<CapaModelo.tbFr3>
@{
    ViewBag.Title = "CalculoFr3";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Datos Fr3</title>
</head>
<body>
    @using (Html.BeginForm("DatosFr3", "CalculoFr3", FormMethod.Post, new { id = "registerForm", enctype = "multipart/form-data", }))
    {
        <div class="row justify-content-center">
            <div class="col-4">
                <div class="fs-6 fw-bold mt-2 mb-3" style=" font-size:18px; color: blue"><label>CALCULO FR3</label></div>

            </div>

        </div>
        <div class="row justify-content-center">
            <div class="col-4">
                <div class="fs-6 fw-bold mt-2 mb-3" style="font-size:16px; color: blue"><label>INGRESE PARAMETROS DE CALCULO</label></div>

            </div>

        </div>


        <div class="row justify-content-center">
            <div class="col-4">
                <div style="font-size:12px" class="fs-6 fw-bold mt-2 mb-3"><label>Aeropuerto Cobro</label></div>

                <select id="Ato" style="font-size:12px" class="form-select" aria-label="Aeropuerto Cobro">

                    <option value="SECA"> CATAMAYO</option>
                    <option value="SECO">FRANCISCO DE ORELLANA</option>
                    <option value="SECU">MARISCAL LAMAR CUENCA</option>
                    <option value="SEGS">SEYMOUR GALAPAGOS</option>
                    <option value="SEGU">JOSE JOAQUIN OLMEDO INTERNACIONAL</option>
                    <option value="SEJD">JUMANDY TENA</option>
                    <option value="SEII">ISABELA GALAPAGOS</option>
                    <option value="SELT">INTERNACIONAL COTOPAXI</option>
                    <option value="SEMC">CRNEL. EDMUNDO CARVAJAL SHELL MERA</option>
                    <option value="SEMT">INTERNACIONAL ELOY ALFARO MANTA</option>
                    <option value="SEQM">AEROPUERTO INTERNACIONAL DE QUITO</option>
                    <option value="SERO">REGIONAL SANTA ROSA</option>
                    <option value="SESA">GENERAL ULPIANO PAEZ</option>
                    <option value="SESM">RIO AMAZONAS</option>
                    <option value="SEST">SAN CRISTOBAL GALAPAGOS</option>
                    <option value="SETN">CRNEL. CARLOS CONCHA TORRES ESMERALDAS</option>
                    <option value="SETU">TCRN.LUIS A. MANTILLA TULCAN</option>

                </select>

                @*<input type="text" style="font-size:12px;text-transform:uppercase" class="form-control form-control-solid" id="Ato" name="Ato" />*@
            </div>
            <div class="col-4">
                <div style="font-size:12px" class="fs-6 fw-bold mt-2 mb-3"><label>Matricula</label></div>
                <input style="font-size:12px;text-transform:uppercase " class="form-control form-control-sm" id="Matricula" name="Matricula" />
            </div>
        </div>
        <div class="row justify-content-center">
            <div style="font-size:12px" class="fs-6 fw-bold mt-2 mb-3"><label>Aerovia</label></div>
        </div>
        <div class="row justify-content-center">

            <div class="col-2">

                <input style="font-size:12px;text-transform:uppercase" class="form-control form-control-sm" id="Origen" name="Origen" />
            </div>

            <div class="col-2">
                <input style="font-size:12px;text-transform:uppercase " class="form-control form-control-sm" id="Destino" name="Destino" />

            </div>
            <div class="col-2">
                <input style="font-size:12px;text-transform:uppercase" class="form-control form-control-sm" id="Destino1" name="Destino1" />

            </div>
            <div class="col-2">
                <input style="font-size:12px;text-transform:uppercase " class="form-control form-control-sm" id="Destino2" name="Destino2" />


            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-4">
                <div style="font-size:12px" class="fs-6 fw-bold mt-2 mb-3"><label>Fecha Ingresa Plataforma</label></div>
                <input type="date" style="font-size:12px;text-transform:uppercase" class="form-control form-control-sm" id="FechaI" name="FechaI" />
            </div>
            <div class="col-4">
                <div style="font-size:12px" class="fs-6 fw-bold mt-2 mb-3"><label>Fecha Salida Plataforma</label></div>
                <input type="date" style="font-size:12px;text-transform:uppercase " class="form-control form-control-sm" id="FechaF" name="FechaF" />
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-4">
                <div style="font-size:12px" class="fs-6 fw-bold mt-2 mb-3"><label>Hora Ingresa Plataforma</label></div>
                <input type="time" style="font-size:12px;text-transform:uppercase" class="form-control form-control-sm" id="HoraI" name="HoraI" />
            </div>
            <div class="col-4">
                <div style="font-size:12px" class="fs-6 fw-bold mt-2 mb-3"><label>Hora Salida Plataforma</label></div>
                <input type="time" style="font-size:12px;text-transform:uppercase " class="form-control form-control-sm" id="HoraF" name="HoraF" />
            </div>
        </div>

        <div class="row justify-content-center">

            <div>

                <button type="button" class="btn btn-sm btn-success" onclick="Consultar()" data-dismiss="modal">Calcular </button>


            </div>
        </div>



    }

        <div class="modal fade" id="largeModal" tabindex="-1" role="dialog" aria-labelledby="largeModal" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header bg-gradient-primary text-white">
                        <h6 class="modal-title text-white" id="modalLabel"> CALCULO FR3</h6>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>


                    <div class="modal-body bg-light">

                        <!-- DATOS GENERALES -->
                        <div class="card shadow-sm mb-3">
                            <div class="card-header bg-primary text-white py-2">
                                <strong>Datos Generales del Vuelo</strong>
                            </div>
                            <div class="card-body">

                                <div class="row mb-2">
                                    <div class="col-md-4">
                                        <label class="form-label text-muted small">Aeropuerto de Cobro</label>
                                        <input class="form-control form-control-sm" id="AtoM" readonly>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-muted small">Matrícula</label>
                                        <input class="form-control form-control-sm" id="MatriculaM" readonly>
                                    </div>
                                </div>

                                <label class="form-label text-muted small mt-2">Ruta</label>
                                <div class="row mb-2">
                                    <div class="col-md-3"><input class="form-control form-control-sm" id="OrigenM" readonly></div>
                                    <div class="col-md-3"><input class="form-control form-control-sm" id="DestinoM" readonly></div>
                                    <div class="col-md-3"><input class="form-control form-control-sm" id="Destino1M" readonly></div>
                                    <div class="col-md-3"><input class="form-control form-control-sm" id="Destino2M" readonly></div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-md-4">
                                        <label class="form-label text-muted small">Distancia</label>
                                        <input class="form-control form-control-sm" id="Distancia" readonly>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- FECHAS Y HORAS -->
                        <div class="card shadow-sm mb-3">
                            <div class="card-header bg-secondary text-white py-2">
                                <strong>Ingreso / Salida Plataforma</strong>
                            </div>
                            <div class="card-body">

                                <div class="row mb-2">
                                    <div class="col-md-4">
                                        <label class="form-label text-muted small">Fecha Ingreso</label>
                                        <input class="form-control form-control-sm" id="FechaIM" readonly>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-muted small">Fecha Salida</label>
                                        <input class="form-control form-control-sm" id="FechaFM" readonly>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="form-label text-muted small">Hora Ingreso</label>
                                        <input class="form-control form-control-sm" id="HoraIM" readonly>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-muted small">Hora Salida</label>
                                        <input class="form-control form-control-sm" id="HoraFM" readonly>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- LIQUIDACIÓN -->
                        <div class="card shadow-sm mb-3">
                            <div class="card-header bg-dark text-white py-2">
                                <strong>Detalle de Liquidación</strong>
                            </div>
                            <div class="card-body">

                                <div class="row mb-2">
                                    <div class="col-md-6 text-primary small fw-bold">Periodos</div>
                                    <div class="col-md-4"><input class="form-control form-control-sm" id="Periodos" readonly></div>
                                </div>
                                <!-- FILA MONETARIA -->
                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-6 small fw-bold text-primary">
                                        Derecho de Estacionamiento
                                    </div>
                                    <div class="col-md-3">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input class="form-control text-end fw-semibold" id="Estacionamiento" readonly>
                                        </div>
                                    </div>
                                   
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-6 small fw-bold text-primary">
                                        Derecho Aterrizaje Diurno
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input class="form-control text-end fw-semibold" id="Aterrizaje" readonly>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-6 small fw-bold text-primary">
                                        Iluminación de Pista
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input class="form-control text-end fw-semibold" id="Iluminacion" readonly>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-6 small fw-bold text-primary">
                                        Charter
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input class="form-control text-end fw-semibold" id="Charter" readonly>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <div class="col-md-6 small fw-bold text-primary">
                                        Derecho Protección Vuelo
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input class="form-control text-end fw-semibold" id="Proteccion" readonly>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-3 align-items-center">
                                    <div class="col-md-6 small fw-bold text-primary">
                                        Protección Antes / Después Ruta
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input class="form-control text-end fw-semibold" id="ProteccionAntes" readonly>
                                        </div>
                                    </div>
                                </div>

                                <hr>

                                <!-- TOTAL -->
                                <div class="row align-items-center">
                                    <div class="col-md-6 fw-bold fs-6 text-danger">
                                        TOTAL A PAGAR
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text fw-bold">$</span>
                                            <input class="form-control text-end fw-bold text-danger" id="Total" readonly>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- NOTA -->
                        <div class="alert alert-warning small py-2">
                            <strong>Nota:</strong> El valor de Iluminación de Pista aplica según aeropuerto y horario de puesta del sol.
                        </div>

                    </div>

                    <div class="modal-footer py-2">
                        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cerrar</button>
                    </div>

                </div>


            </div>
        </div>
</body>

</html>
@section scripts{
    <script>
        $(document).ready(function () {

        });

        function modalAdjunto() {
            $('#FormModal').modal('show');
        }



        function Consultar() {

            var _Ato = $('#Ato').val();
            var _Matricula = $('#Matricula').val();
            var _Origen = $('#Origen').val();
            var _Destino = $('#Destino').val();
            var _Destino1 = $('#Destino1').val();
            var _Destino2 = $('#Destino2').val();
            var _FechaI = $('#FechaI').val();
            var _FechaF = $('#FechaF').val();
            var _HoraI = $('#HoraI').val();
            var _HoraF = $('#HoraF').val();

            $("#Estacionamiento").val("");
            $("#Aterrizaje").val("");
            $("#Iluminacion").val("");
            $("#Charter").val("");
            $("#Proteccion").val("");
            $("#ProteccionAntes").val("");
            $("#Total").val("");
            $("#Periodos").val("");
            $("#Distancia").val("");

            $.ajax({
                url: $.MisUrls.url._DetalleFr3,
                type: "GET",
                contentType: "application/json;charset=UTF-8",
                dataType: "json",
                data: { Ato: _Ato, Matricula: _Matricula, Origen: _Origen, Destino: _Destino, Destino1: _Destino1, Destino2: _Destino2, FechaI: _FechaI, FechaF: _FechaF, HoraI: _HoraI, HoraF: _HoraF },
                success: function (e) {

                    $("#AtoM").val(e.AEROPUERTO);
                    $("#MatriculaM").val(e.MATRICULA);
                    $("#OrigenM").val(e.ORIGEN);
                    $("#DestinoM").val(e.DESTINO);
                    $("#Destino1M").val(e.DESTINO1);
                    $("#Destino2M").val(e.DESTINO2);
                    $("#FechaIM").val(e.FECHAINGRESOPLATAFORMA);
                    $("#FechaFM").val(e.FECHASALIDAPLATAFORMA);
                    $("#HoraIM").val(e.HORAINGRESOPLATAFORMA);
                    $("#HoraFM").val(e.HORASALIDAPLATAFORMA);


                    $("#Estacionamiento").val(e.DERECHOESTACIONAMIENTO);
                    $("#Aterrizaje").val(e.DERECHOATERRIZAJEDIURNO);
                    $("#Iluminacion").val(e.DERECHOILUMINACION);
                    $("#Charter").val(e.CHARTER);
                    $("#Proteccion").val(e.DERECHOPROTVLO);
                    $("#ProteccionAntes").val(e.DERECHOPROTANTESYDESPUES);
                    $("#Total").val(e.TOTAL);
                    $("#Periodos").val(e.PERIODO);
                    $("#Distancia").val(e.NDISTANCIA);


                },
                error: function (errormessage) {
                    Swal.fire("Mensaje", "Financiero: " + errormessage, "warning");
                }
            });


            $('#largeModal').modal('show');
        }


    </script>
}