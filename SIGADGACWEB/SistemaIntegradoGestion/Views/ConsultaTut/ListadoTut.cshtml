@model IEnumerable<CapaModelo.tbTut>
@{
    ViewBag.Title = "Listado de Documentos TUT";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var totalTut = Model != null ? Model.Count() : 0;
    var totalMonto = Model != null ? Model.Sum(x => x.TOTAL) : 0;
    var totalProcesados = Model != null ? Model.Count(x => x.ESTADO == "PROCESADO") : 0;
    var totalNoImpresos = Model != null ? Model.Count(x => x.IMPRESO == "S" && x.ESTADO == "PROCESADO") : 0;
    var totalAeropuertos = Model != null ? Model.Select(x => x.AEROPUERTO).Where(a => !string.IsNullOrEmpty(a)).Distinct().Count() : 0;

    var resumenAeropuertos = Model != null ? Model
        .GroupBy(x => string.IsNullOrEmpty(x.AEROPUERTO) ? "N/A" : x.AEROPUERTO)
        .Select(g => new { Aeropuerto = g.Key, Cantidad = g.Count(), TotalMonto = g.Sum(x => x.TOTAL) })
        .OrderByDescending(x => x.TotalMonto)
        .ToList() : null;
}

<style>
    .card-kpi {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 10px;
    }
    .card-kpi:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 15px rgba(0,0,0,0.08) !important;
    }
    .badge-pill-custom {
        padding: 0.5em 0.85em;
        font-size: 0.82rem;
        font-weight: 600;
        border-radius: 50rem;
    }
    .table-executive thead th {
        background-color: #1a2226;
        color: #ffffff;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: none;
        padding: 12px 15px;
    }
    .table-executive tbody td {
        vertical-align: middle;
        padding: 12px 15px;
        font-size: 0.9rem;
    }
    .detail-label {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #6c757d;
        letter-spacing: 0.5px;
        margin-bottom: 0.35rem;
    }
    .detail-value {
        font-size: 0.92rem;
        font-weight: 600;
        color: #212529;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        padding: 8px 12px;
        height: auto;
    }
    .detail-value-highlight {
        background-color: #eaf2fd;
        border-color: #b6d4fe;
        color: #004085;
        font-weight: 700;
    }
</style>

<div class="container-fluid pt-3">

    <!-- Header Principal -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="mb-2 mb-md-0">
            <h2 class="font-weight-bold text-dark mb-1" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                <i class="fas fa-receipt text-primary mr-2"></i> Tablero Ejecutivo de Documentos TUT
            </h2>
            <p class="text-muted mb-0 small">
                Monitoreo consolidado de tasas de uso terminal (TUT)
            </p>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row mb-4">
        <!-- Total Documentos TUT -->
        <div class="col-xl col-md-4 col-sm-6 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #0056b3 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Total Documentos</span>
                            <h3 class="mb-0 font-weight-bold text-dark mt-1">@totalTut</h3>
                        </div>
                        <div class="rounded-circle bg-light p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fas fa-receipt text-primary fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Monto Total -->
        <div class="col-xl col-md-4 col-sm-6 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #28a745 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Total Liquidado</span>
                            <h3 class="mb-0 font-weight-bold text-success mt-1">$@totalMonto.ToString("N2")</h3>
                        </div>
                        <div class="rounded-circle bg-light p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fas fa-dollar-sign text-success fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Aeropuertos -->
        <div class="col-xl col-md-4 col-sm-6 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #6f42c1 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Aeropuertos</span>
                            <h3 class="mb-0 font-weight-bold mt-1" style="color: #6f42c1;">@totalAeropuertos</h3>
                        </div>
                        <div class="rounded-circle bg-light p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fas fa-plane-arrival fa-lg" style="color: #6f42c1;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Documentos Procesados -->
        <div class="col-xl col-md-6 col-sm-6 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #17a2b8 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Procesados</span>
                            <h3 class="mb-0 font-weight-bold text-info mt-1">@totalProcesados</h3>
                        </div>
                        <div class="rounded-circle bg-light p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fas fa-check-circle text-info fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pendientes Impresión -->
        <div class="col-xl col-md-6 col-sm-6 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #dc3545 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Pendientes Imp.</span>
                            <h3 class="mb-0 font-weight-bold text-danger mt-1">@totalNoImpresos</h3>
                        </div>
                        <div class="rounded-circle bg-light p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fas fa-print text-danger fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Totales por Aeropuerto -->
    @if (resumenAeropuertos != null && resumenAeropuertos.Any())
    {
        <div class="card border-0 shadow-sm rounded-lg mb-4">
            <div class="card-header bg-white py-2 border-bottom d-flex align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-dark" style="font-size: 0.95rem;">
                    <i class="fas fa-plane-departure text-primary mr-2"></i> Resumen de Totales por Aeropuerto
                </h6>
                <span class="badge badge-light border rounded-pill px-3 py-1 font-weight-bold text-primary" style="font-size: 0.8rem;">
                    <i class="fas fa-building mr-1"></i> @resumenAeropuertos.Count Aeropuerto(s)
                </span>
            </div>
            <div class="card-body p-3 bg-light">
                <div class="d-flex flex-wrap align-items-center" style="gap: 12px;">
                    @foreach (var aero in resumenAeropuertos)
                    {
                        <div class="card border-0 shadow-sm bg-white px-3 py-2" style="border-radius: 10px; min-width: 220px; border-left: 4px solid #007bff !important;">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-uppercase text-muted font-weight-bold small d-block mb-1">
                                        <i class="fas fa-map-marker-alt text-danger mr-1"></i> @aero.Aeropuerto
                                    </span>
                                    <h5 class="mb-0 font-weight-bold text-success" style="font-size: 1.1rem;">
                                        $@aero.TotalMonto.ToString("N2")
                                    </h5>
                                </div>
                                <span class="badge badge-light border text-primary font-weight-bold ml-2 px-2 py-1" style="border-radius: 12px;">
                                    @aero.Cantidad reg.
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Card Filtro de Búsqueda -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-body p-3">
            @using (Html.BeginForm("ListadoTut", "ConsultaTut", FormMethod.Post, new { id = "registerForm", enctype = "multipart/form-data" }))
            {
                <div class="row align-items-center">
                    <div class="col-md-3 mb-2 mb-md-0">
                        <label class="font-weight-bold text-muted mb-0 small text-uppercase" style="letter-spacing: 0.5px;">
                            <i class="fas fa-calendar-alt mr-1 text-primary"></i> Fecha Elaboración
                        </label>
                    </div>
                    <div class="col-md-6 mb-2 mb-md-0">
                        <input type="date" name="FechaEmision" id="FechaEmision" class="form-control" required />
                    </div>
                    <div class="col-md-3 text-md-right">
                        <button type="submit" class="btn btn-primary btn-block rounded-pill shadow-sm font-weight-bold">
                            <i class="fas fa-search mr-1"></i> Buscar Documentos
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main Table Executive Card -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="card-title m-0 font-weight-bold text-dark" style="font-size: 1.05rem;">
                <i class="fas fa-list-ul text-primary mr-2"></i> Listado Registrado de Documentos TUT
            </h5>
            <span class="badge badge-light border px-3 py-2 font-weight-normal" style="border-radius: 20px;">
                <i class="fas fa-layer-group text-primary mr-1"></i> @totalTut Registros
            </span>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="tbDetalle" class="table table-hover table-striped table-executive w-100">
                    <thead>
                        <tr>
                            <th><i class="fas fa-hashtag mr-1"></i> Num. TUT</th>
                            <th><i class="fas fa-calendar-alt mr-1"></i> Fecha Emisión</th>
                            <th><i class="fas fa-plane-arrival mr-1"></i> Aeropuerto</th>
                            <th><i class="fas fa-plane mr-1"></i> Matrícula</th>
                            <th><i class="fas fa-file-invoice mr-1"></i> Factura</th>
                            <th><i class="fas fa-receipt mr-1"></i> Doc. RE</th>
                            <th class="text-right"><i class="fas fa-dollar-sign mr-1"></i> Valor</th>
                            <th class="text-center"><i class="fas fa-info-circle mr-1"></i> Estado</th>
                            <th class="text-center"><i class="fas fa-print mr-1"></i> Impresión</th>
                            <th class="text-center"><i class="fas fa-cogs mr-1"></i> Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="font-weight-bold text-dark">
                                    <span class="badge badge-light border text-primary font-weight-bold px-3 py-2" style="font-size: 1.1rem; letter-spacing: 0.5px;">
                                        @Html.DisplayFor(modelItem => item.NUMEROTASA)
                                    </span>
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.FECHAEMISION)</td>
                                <td>@Html.DisplayFor(modelItem => item.AEROPUERTO)</td>
                                <td>
                                    <span class="font-weight-bold text-dark">
                                        <i class="fas fa-plane text-muted mr-1" style="font-size:0.8rem"></i> @Html.DisplayFor(modelItem => item.MATRICULA)
                                    </span>
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.NUMEROFACTURA)</td>
                                <td>@Html.DisplayFor(modelItem => item.RECAUDACION)</td>
                                <td class="text-right font-weight-bold text-success">
                                    $@item.TOTAL.ToString("N2")
                                </td>
                                <td class="text-center">
                                    @if (item.ESTADO == "PROCESADO")
                                    {
                                        <span class="badge bg-success text-white badge-pill-custom shadow-sm"><i class="fas fa-check-circle mr-1"></i> @item.ESTADO</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white badge-pill-custom shadow-sm">@item.ESTADO</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IMPRESO == "S" && item.ESTADO == "PROCESADO")
                                    {
                                        <span class="badge bg-danger text-white badge-pill-custom shadow-sm">
                                            <i class="fas fa-exclamation-circle mr-1"></i> No Impresa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-1">
                                            <i class="fas fa-check mr-1"></i> Impreso
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill shadow-sm font-weight-bold mr-1" onclick="Consultar('@item.NUMEROTASA', '@item.ATO', '@item.AÑO')">
                                            <i class="fas fa-search mr-1"></i> Consulta
                                        </button>
                                        <a class="btn btn-sm btn-outline-secondary rounded-pill shadow-sm font-weight-bold" href="@Url.Action("DescargaTasa", "ConsultaTut", new { NumeroTasa = item.NUMEROTASA, Ato = item.ATO, FechaEmision = item.FECHAEMISION, Ruc = item.RUC.ToString() })">
                                            <i class="fas fa-download mr-1"></i> Descarga
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Detalle Ejecutivo -->
    <div class="modal fade" id="largeModal" tabindex="-1" role="dialog" aria-labelledby="largeModal" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title font-weight-bold text-white m-0" id="modalLabel">
                        <i class="fas fa-receipt text-primary mr-2"></i> Detalle de Información TUT
                    </h5>
                    <button type="button" class="close text-white opacity-100" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4 bg-light">
                    
                    <!-- Bloque 1: Datos Generales de TUT -->
                    <div class="card border-0 shadow-sm bg-white mb-3" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-primary m-0"><i class="fas fa-info-circle mr-2"></i>Datos Generales</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-3 form-group mb-2">
                                    <label class="detail-label"><i class="fas fa-hashtag text-primary mr-1"></i> Número Tasa</label>
                                    <input class="form-control detail-value detail-value-highlight font-weight-bold text-primary" id="NUMEROTASA" style="font-size: 1.2rem; height: 40px;" readonly />
                                </div>
                                <div class="col-md-3 form-group mb-2">
                                    <label class="detail-label">Fecha Emisión</label>
                                    <input class="form-control detail-value" id="FECHAEMISION" readonly />
                                </div>
                                <div class="col-md-6 form-group mb-2">
                                    <label class="detail-label">Aeropuerto</label>
                                    <input class="form-control detail-value" id="AEROPUERTO" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bloque 2: Datos de Aeronave y Ruta -->
                    <div class="card border-0 shadow-sm bg-white mb-3" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-primary m-0"><i class="fas fa-plane mr-2"></i>Aeronave y Ruta</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Matrícula</label>
                                    <input class="form-control detail-value font-weight-bold text-primary" id="MATRICULA" readonly />
                                </div>
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Ámbito (Nacional/Int.)</label>
                                    <input class="form-control detail-value" id="NACINT" readonly />
                                </div>
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Ruta (Origen - Destino)</label>
                                    <div class="d-flex">
                                        <input class="form-control detail-value mr-1" id="ORIGEN" readonly placeholder="Origen" />
                                        <input class="form-control detail-value" id="DESTINO" readonly placeholder="Destino" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bloque 3: Compañía y Facturación -->
                    <div class="card border-0 shadow-sm bg-white mb-3" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-primary m-0"><i class="fas fa-building mr-2"></i>Compañía y Facturación</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">RUC</label>
                                    <input class="form-control detail-value detail-value-highlight" id="RUC" readonly />
                                </div>
                                <div class="col-md-8 form-group mb-2">
                                    <label class="detail-label">Razón Social</label>
                                    <input class="form-control detail-value" id="RAZONSOCIAL" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Forma Pago</label>
                                    <input class="form-control detail-value" id="FORMAPAGO" readonly />
                                </div>
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Banco</label>
                                    <input class="form-control detail-value" id="BANCO" readonly />
                                </div>
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Transferencia</label>
                                    <input class="form-control detail-value" id="TRANSFERENCIA" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">N° Factura</label>
                                    <input class="form-control detail-value" id="NUMEROFACTURA" readonly />
                                </div>
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Cód. Recaudación</label>
                                    <input class="form-control detail-value" id="RECAUDACION" readonly />
                                </div>
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Estado</label>
                                    <input class="form-control detail-value font-weight-bold text-success" id="ESTADO" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group mb-2">
                                    <label class="detail-label">Email</label>
                                    <input class="form-control detail-value" id="EMAIL" readonly />
                                </div>
                                <div class="col-md-6 form-group mb-2">
                                    <label class="detail-label">Observaciones</label>
                                    <input class="form-control detail-value" id="OBSERVACION" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bloque 4: Desglose de Tasas TUT -->
                    <div class="card border-0 shadow-sm bg-white mb-3" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-primary m-0"><i class="fas fa-file-invoice-dollar mr-2"></i>Desglose de Tasas y Valores</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered table-executive mb-0">
                                    <thead>
                                        <tr>
                                            <th>Descripción Tasa</th>
                                            <th class="text-right" style="width: 200px;">Valor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td>Tasa TUT</td><td><input class="form-control detail-value text-right" id="TASATUT" readonly></td></tr>
                                        <tr><td>Tasa WT</td><td><input class="form-control detail-value text-right" id="TASAWT" readonly></td></tr>
                                        <tr><td>Tasa CFR</td><td><input class="form-control detail-value text-right" id="TASACFR" readonly></td></tr>
                                        <tr class="bg-light">
                                            <td class="font-weight-bold text-dark align-middle">TOTAL LIQUIDADO</td>
                                            <td><input class="form-control detail-value text-right font-weight-bold text-success" id="TOTAL" style="font-size: 1.1rem;" readonly></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Bloque 5: Auditoría -->
                    <div class="card border-0 shadow-sm bg-white mb-0" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-muted m-0" style="font-size: 0.85rem;"><i class="fas fa-history mr-2"></i>Datos de Registro y Auditoría</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Usuario Crea</label>
                                    <input class="form-control detail-value" id="USUARIOCREA" readonly />
                                </div>
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">F. Crea</label>
                                    <input class="form-control detail-value" id="FECHACREA" readonly />
                                </div>
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">H. Crea</label>
                                    <input class="form-control detail-value" id="HORACREA" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 form-group mb-0">
                                    <label class="detail-label">Nombre Usuario Registrado</label>
                                    <input class="form-control detail-value font-weight-bold" id="NOMBREUSUARIO" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer bg-white border-top py-2">
                    <button type="button" class="btn btn-secondary px-4 rounded-pill font-weight-bold" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts{
    <script>
        $(document).ready(function () {
            if ($.fn.dataTable.isDataTable('#tbDetalle')) {
                $('#tbDetalle').DataTable().destroy();
            }

            $('#tbDetalle').DataTable({
                "responsive": true,
                "autoWidth": false,
                "pageLength": 10,
                "language": {
                    "sProcessing":     "Procesando...",
                    "sLengthMenu":     "Mostrar _MENU_ registros",
                    "sZeroRecords":    "No se encontraron resultados",
                    "sEmptyTable":     "Ningún dato disponible en esta tabla",
                    "sInfo":           "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                    "sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
                    "sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
                    "sSearch":         "Buscar:",
                    "oPaginate": {
                        "sFirst":    "Primero",
                        "sLast":     "Último",
                        "sNext":     "Siguiente",
                        "sPrevious": "Anterior"
                    }
                }
            });
        });

        function Consultar(NumeroTut, Ato, Ano) {
            $.ajax({
                url: $.MisUrls.url._CargaDetalleTutDatos,
                type: "GET",
                contentType: "application/json;charset=UTF-8",
                dataType: "json",
                data: { NumeroTut: NumeroTut, Ato: Ato, Ano: Ano },
                success: function (e) {
                    $("#NUMEROTASA").val(e.NUMEROTASA);
                    $("#FECHAEMISION").val(e.FECHAEMISION);
                    $("#AEROPUERTO").val(e.AEROPUERTO);
                    $("#AÑO").val(e.AÑO);
                    $("#NACINT").val(e.NACINT);
                    $("#RUTA").val(e.RUTA);
                    $("#ORIGEN").val(e.ORIGEN);
                    $("#DESTINO").val(e.DESTINO);
                    $("#MATRICULA").val(e.MATRICULA);

                    $("#ESTADO").val(e.ESTADO);
                    $("#RUC").val(e.RUC);
                    $("#RAZONSOCIAL").val(e.RAZONSOCIAL);
                    $("#FORMAPAGO").val(e.FORMAPAGO);
                    $("#BANCO").val(e.BANCO);
                    $("#TRANSFERENCIA").val(e.TRANSFERENCIA);
                    $("#NUMEROFACTURA").val(e.NUMEROFACTURA);
                    $("#RECAUDACION").val(e.RECAUDACION);
                    $("#USO").val(e.USO);
                    $("#EMAIL").val(e.EMAIL);
                    $("#OBSERVACION").val(e.OBSERVACION);

                    $("#FECHACREA").val(e.FECHACREA);
                    $("#USUARIOCREA").val(e.USUARIOCREA);
                    $("#HORACREA").val(e.HORACREA);
                    $("#FECHAMODIFICA").val(e.FECHAMODIFICA);
                    $("#USUARIOMODIFICA").val(e.USUARIOMODIFICA);
                    $("#TASATUT").val(e.TASATUT != null ? ("$ " + parseFloat(e.TASATUT).toFixed(2)) : "");
                    $("#TASAWT").val(e.TASAWT != null ? ("$ " + parseFloat(e.TASAWT).toFixed(2)) : "");
                    $("#TASACFR").val(e.TASACFR != null ? ("$ " + parseFloat(e.TASACFR).toFixed(2)) : "");
                    $("#TOTAL").val(e.TOTAL != null ? ("$ " + parseFloat(e.TOTAL).toFixed(2)) : "");
                    $("#NOMBREUSUARIO").val(e.NOMBREUSUARIO);
                },
                error: function (errormessage) {
                    Swal.fire("Mensaje", "Financiero: " + errormessage, "warning");
                }
            });

            $('#largeModal').modal('show');
        }
    </script>
}
