                        </div>
                    </div>

                </div>
                <div class="modal-footer bg-white border-top py-2">
                    <button type="button" class="btn btn-secondary px-4 rounded-pill font-weight-bold" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts{
    <script>
        $(document).ready(function () {
            if ($.fn.dataTable.isDataTable('#tbDetalle')) {
                $('#tbDetalle').DataTable().destroy();
            }

            $('#tbDetalle').DataTable({
                "responsive": true,
                "autoWidth": false,
                "pageLength": 10,
                "language": {
                    "sProcessing":     "Procesando...",
                    "sLengthMenu":     "Mostrar _MENU_ registros",
                    "sZeroRecords":    "No se encontraron resultados",
                    "sEmptyTable":     "Ningún dato disponible en esta tabla",
                    "sInfo":           "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                    "sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
                    "sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
                    "sSearch":         "Buscar:",
                    "oPaginate": {
                        "sFirst":    "Primero",
                        "sLast":     "Último",
                        "sNext":     "Siguiente",
                        "sPrevious": "Anterior"
                    }
                }
            });
        });

        function Consultar(Lugar, Dependencia, Fechaelab, Turno) {
            $("#Lugar").val("");
            $("#Dependencia").val("");
            $("#Fechaelab").val("");
            $("#Turno").val("");
            $("#Licresponsable").val("");
            $("#Nombreresponsable").val("");
            $("#Licturnosaliente").val("");
            $("#Nombreresponsablesal").val("");
            $("#IFRDEP").val("");
            $("#IFRARR").val("");
            $("#VFRDEP").val("");
            $("#VFRARR").val("");
            $("#OVR").val("");
            $("#TGL").val("");
            $("#SOBREVUELOS").val("");
            $("#TOTAL").val("");
            $("#TOTALIFR").val("");
            $("#TOTALVFR").val("");
            $("#TOTALDEP").val("");
            $("#TOTALARR").val("");
            $("#TOTALGENERAL").val("");

            $.ajax({
                url: $.MisUrls.url._DetalleControladorAtcDiario,
                type: "GET",
                contentType: "application/json;charset=UTF-8",
                dataType: "json",
                data: { Lugar: Lugar, Dependencia: Dependencia, Fechaelab: Fechaelab, Turno: Turno },
                success: function (e) {
                    $("#Lugar").val(e.LUGAR);
                    $("#Dependencia").val(e.DEPENDENCIA);
                    $("#Fechaelab").val(e.FECHAELABORACION);
                    $("#Turno").val(e.TURNO);
                    $("#Licresponsable").val(e.LICENCIARESPONSABLE);
                    $("#Nombreresponsable").val(e.NOMBRERESPONSABLE);
                    $("#Licturnosaliente").val(e.LICENCIARESPSALIEN);
                    $("#Nombreresponsablesal").val(e.NOMBRERESSALIDA);
                    $("#IFRDEP").val(e.IFRDEP);
                    $("#IFRARR").val(e.IFRARR);
                    $("#VFRDEP").val(e.VFRDEP);
                    $("#VFRARR").val(e.VFRARR);
                    $("#OVR").val(e.OVR);
                    $("#TGL").val(e.TGL);
                    $("#TOTALIFR").val(e.TOTALIFR);
                    $("#TOTALVFR").val(e.TOTALVFR);
                    $("#TOTALDEP").val(e.TOTALDEP);
                    $("#TOTALARR").val(e.TOTALARR);
                    $("#TOTALGENERAL").val(e.TOTALGENERAL);
                    $("#SOBREVUELOS").val(e.SOBSEGU);
                    $("#TOTAL").val(e.TOTGENSEGU);

                    $("#tbDetalleControladores tbody").html("");
                    $.each(e.oDetalleControladorAtc, function (i, row) {
                        $("<tr>").append(
                            $("<td>").html('<span class="font-weight-bold text-primary">' + row["LICENCIACONTROLADOR"] + '</span>'),
                            $("<td>").text(row["NOMBRECONTROLADOR"]),
                            $("<td>").text(row["VIGENCIACEMAC"]),
                            $("<td class='text-center'>").html(row["ESTADO"] === 'ACTIVO' ? '<span class="badge bg-success text-white px-2 py-1">ACTIVO</span>' : '<span class="badge bg-secondary text-white px-2 py-1">' + row["ESTADO"] + '</span>')
                        ).appendTo("#tbDetalleControladores tbody");
                    });

                    $("#tbDetalleNotams tbody").html("");
                    $.each(e.oDetalleNotamsAtc, function (i, row) {
                        var detalleText = [
                            row["DESCRIPCION"], row["DESCRIPCION1"], row["DESCRIPCION2"],
                            row["DESCRIPCION3"], row["DESCRIPCION4"], row["DESCRIPCION5"],
                            row["DESCRIPCION6"], row["DESCRIPCION7"], row["DESCRIPCION8"],
                            row["DESCRIPCION9"], row["DESCRIPCION10"], row["DESCRIPCION11"], row["DESCRIPCION12"]
                        ].filter(Boolean).join(" ");

                        $("<tr>").append(
                            $("<td>").html('<span class="badge badge-light border text-primary font-weight-bold">' + row["CODIGONOTAMS"] + '</span>'),
                            $("<td>").text(detalleText)
                        ).appendTo("#tbDetalleNotams tbody");
                    });

                    $("#tbDetalleEventos tbody").html("");
                    $.each(e.oDetalleEventosAtc, function (i, row) {
                        const $row = $("<tr>");
                        const $tdHoraUtc = $("<td>").text(row["HORAUTC"]);
                        const $tdCodigoEvento = $("<td>").html('<span class="font-weight-bold">' + row["CODIGOEVENTO"] + '</span>');
                        const $tdDescripcion = $("<td>").text(row["DESCRIPCION"]);
                        const $tdUsuario = $("<td>").text(row["USUARIO"]);

                        if (row["IMPRESOALERTA"] === "I") {
                            $tdHoraUtc.addClass("text-danger font-weight-bold");
                            $tdCodigoEvento.addClass("text-danger font-weight-bold");
                            $tdDescripcion.addClass("text-danger font-weight-bold");
                            $tdUsuario.addClass("text-danger font-weight-bold");
                        }

                        $row.append($tdHoraUtc, $tdCodigoEvento, $tdDescripcion, $tdUsuario);
                        $row.appendTo("#tbDetalleEventos tbody");
                    });

                    if (e.LUGAR == "SEGU") {
                        if (e.DEPENDENCIA == "TWR") {
                            $("#costadisplay").hide();
                            $("#sierradisplay").show();
                        }
                        else {
                            $("#costadisplay").show();
                            $("#sierradisplay").hide();
                        }
                    }
                    else {
                        $("#costadisplay").hide();
                        $("#sierradisplay").show();
                    }
                },
                error: function (errormessage) {
                    Swal.fire("Mensaje", "Financiero: " + errormessage, "warning");
                }
            });

            $('#largeModal').modal('show');
        }
    </script>
}
