@model IEnumerable<CapaModelo.tbItsControlAtc>
@{
    ViewBag.Title = "Listado de Informes Diarios ITS";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var totalIts = Model != null ? Model.Count() : 0;
    var totalLugares = Model != null ? Model.Select(x => x.LUGAR).Where(l => !string.IsNullOrEmpty(l)).Distinct().Count() : 0;
    var totalDependencias = Model != null ? Model.Select(x => x.DEPENDENCIA).Where(d => !string.IsNullOrEmpty(d)).Distinct().Count() : 0;
    var totalImpresos = Model != null ? Model.Count(x => x.ESTADOD == "IMPRESO") : 0;
    var totalPendientes = Model != null ? Model.Count(x => x.ESTADOD != "IMPRESO") : 0;

    var resumenLugaresDep = Model != null ? Model
        .GroupBy(x => string.IsNullOrEmpty(x.LUGAR) ? "N/A" : x.LUGAR)
        .Select(g => new {
            Lugar = g.Key,
            CantidadTotal = g.Count(),
            Dependencias = g.GroupBy(d => string.IsNullOrEmpty(d.DEPENDENCIA) ? "N/A" : d.DEPENDENCIA)
                            .Select(dg => new { Dependencia = dg.Key, Cantidad = dg.Count() })
                            .OrderByDescending(x => x.Cantidad)
                            .ToList()
        })
        .OrderByDescending(x => x.CantidadTotal)
        .ToList() : null;
}

<style>
    .card-kpi {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 10px;
    }
    .card-kpi:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 15px rgba(0,0,0,0.08) !important;
    }
    .badge-pill-custom {
        padding: 0.5em 0.85em;
        font-size: 0.82rem;
        font-weight: 600;
        border-radius: 50rem;
    }
    .table-executive thead th {
        background-color: #1a2226;
        color: #ffffff;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: none;
        padding: 12px 15px;
    }
    .table-executive tbody td {
        vertical-align: middle;
        padding: 12px 15px;
        font-size: 0.9rem;
    }
    .detail-label {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #6c757d;
        letter-spacing: 0.5px;
        margin-bottom: 0.35rem;
    }
    .detail-value {
        font-size: 0.92rem;
        font-weight: 600;
        color: #212529;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        padding: 8px 12px;
        height: auto;
    }
    .detail-value-highlight {
        background-color: #eaf2fd;
        border-color: #b6d4fe;
        color: #004085;
        font-weight: 700;
    }
</style>

<div class="container-fluid pt-3">

    <!-- Header Principal -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="mb-2 mb-md-0">
            <h2 class="font-weight-bold text-dark mb-1" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                <i class="fas fa-file-invoice text-primary mr-2"></i> Tablero Ejecutivo de Informes Diarios ITS
            </h2>
            <p class="text-muted mb-0 small">
                Monitoreo consolidado de bitácora e informes de control de tránsito aéreo (ITS)
            </p>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row mb-4">
        <!-- Total Informes -->
        <div class="col-xl col-md-4 col-sm-6 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #0056b3 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Total Informes</span>
                            <h3 class="mb-0 font-weight-bold text-dark mt-1">@totalIts</h3>
                        </div>
                        <div class="rounded-circle bg-light p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fas fa-file-alt text-primary fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lugares / Aeropuertos -->
        <div class="col-xl col-md-4 col-sm-6 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #6f42c1 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Lugares / ATO</span>
                            <h3 class="mb-0 font-weight-bold mt-1" style="color: #6f42c1;">@totalLugares</h3>
                        </div>
                        <div class="rounded-circle bg-light p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fas fa-map-marker-alt fa-lg" style="color: #6f42c1;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dependencias -->
        <div class="col-xl col-md-4 col-sm-6 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #20c997 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Dependencias</span>
                            <h3 class="mb-0 font-weight-bold mt-1" style="color: #20c997;">@totalDependencias</h3>
                        </div>
                        <div class="rounded-circle bg-light p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fas fa-sitemap fa-lg" style="color: #20c997;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Informes Impresos -->
        <div class="col-xl col-md-6 col-sm-6 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #28a745 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Impresos</span>
                            <h3 class="mb-0 font-weight-bold text-success mt-1">@totalImpresos</h3>
                        </div>
                        <div class="rounded-circle bg-light p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fas fa-check-circle text-success fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Informes Pendientes -->
        <div class="col-xl col-md-6 col-sm-6 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #ffc107 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Pendientes</span>
                            <h3 class="mb-0 font-weight-bold text-warning mt-1">@totalPendientes</h3>
                        </div>
                        <div class="rounded-circle bg-light p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fas fa-clock text-warning fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Totales por Lugar y Dependencias -->
    @if (resumenLugaresDep != null && resumenLugaresDep.Any())
    {
        <div class="card border-0 shadow-sm rounded-lg mb-4">
            <div class="card-header bg-white py-2 border-bottom d-flex align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-dark" style="font-size: 0.95rem;">
                    <i class="fas fa-map-marker-alt text-primary mr-2"></i> Resumen de Informes por Lugar y Dependencias
                </h6>
                <span class="badge badge-light border rounded-pill px-3 py-1 font-weight-bold text-primary" style="font-size: 0.8rem;">
                    <i class="fas fa-building mr-1"></i> @resumenLugaresDep.Count Lugar(es)
                </span>
            </div>
            <div class="card-body p-3 bg-light">
                <div class="d-flex flex-wrap align-items-stretch" style="gap: 15px;">
                    @foreach (var lug in resumenLugaresDep)
                    {
                        <div class="card border-0 shadow-sm bg-white p-3" style="border-radius: 10px; min-width: 260px; flex: 1 1 260px; border-left: 4px solid #007bff !important;">
                            <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                                <span class="text-uppercase text-dark font-weight-bold" style="font-size: 1rem;">
                                    <i class="fas fa-plane-arrival text-danger mr-1"></i> Aeropuerto @lug.Lugar
                                </span>
                                <span class="badge badge-primary rounded-pill px-3 py-1 font-weight-bold" style="font-size: 0.85rem;">
                                    @lug.CantidadTotal total
                                </span>
                            </div>
                            
                            <!-- Sub-cuadros por Dependencia -->
                            <div class="d-flex flex-wrap" style="gap: 8px;">
                                @foreach (var dep in lug.Dependencias)
                                {
                                    <div class="bg-light border rounded p-2 flex-grow-1 text-center" style="min-width: 100px;">
                                        <span class="text-muted font-weight-bold d-block" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                            <i class="fas fa-sitemap text-info mr-1"></i> @dep.Dependencia
                                        </span>
                                        <span class="font-weight-bold text-dark" style="font-size: 1.05rem;">
                                            @dep.Cantidad <span class="small text-muted font-weight-normal" style="font-size: 0.75rem;">inf.</span>
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Card Filtro de Búsqueda -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-body p-3">
            @using (Html.BeginForm("ListadoAtcDiario", "ControlAtcDiario", FormMethod.Post, new { id = "registerForm", enctype = "multipart/form-data" }))
            {
                <div class="row align-items-center">
                    <div class="col-md-3 mb-2 mb-md-0">
                        <label class="font-weight-bold text-muted mb-0 small text-uppercase" style="letter-spacing: 0.5px;">
                            <i class="fas fa-calendar-alt mr-1 text-primary"></i> Fecha Elaboración
                        </label>
                    </div>
                    <div class="col-md-3 mb-2 mb-md-0">
                        <input type="date" name="FechaElab" id="FechaElab" class="form-control" required />
                    </div>
                    <div class="col-md-3 mb-2 mb-md-0">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-light border-right-0"><i class="fas fa-plane-departure text-muted"></i></span>
                            </div>
                            <input type="text" name="Aeropuerto" id="Aeropuerto" class="form-control border-left-0 text-uppercase" placeholder="Aeropuerto (Ej: SEGU)" />
                        </div>
                    </div>
                    <div class="col-md-3 text-md-right">
                        <button type="submit" class="btn btn-primary btn-block rounded-pill shadow-sm font-weight-bold">
                            <i class="fas fa-search mr-1"></i> Buscar Informes
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main Table Executive Card -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="card-title m-0 font-weight-bold text-dark" style="font-size: 1.05rem;">
                <i class="fas fa-list-ul text-primary mr-2"></i> Listado Registrado de Informes ITS
            </h5>
            <span class="badge badge-light border px-3 py-2 font-weight-normal" style="border-radius: 20px;">
                <i class="fas fa-layer-group text-primary mr-1"></i> @totalIts Registros
            </span>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="tbDetalle" class="table table-hover table-striped table-executive w-100">
                    <thead>
                        <tr>
                            <th><i class="fas fa-map-marker-alt mr-1"></i> Lugar</th>
                            <th><i class="fas fa-sitemap mr-1"></i> Dependencia</th>
                            <th><i class="fas fa-calendar-alt mr-1"></i> Fecha Elaboración</th>
                            <th><i class="fas fa-clock mr-1"></i> Turno</th>
                            <th><i class="fas fa-user-shield mr-1"></i> Responsable Turno</th>
                            <th class="text-center"><i class="fas fa-info-circle mr-1"></i> Estado</th>
                            <th class="text-center"><i class="fas fa-cogs mr-1"></i> Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="font-weight-bold text-dark">
                                        <span class="badge badge-light border text-primary font-weight-bold px-2 py-1">
                                            <i class="fas fa-plane-arrival text-muted mr-1"></i> @Html.DisplayFor(modelItem => item.LUGAR)
                                        </span>
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.DEPENDENCIA)</td>
                                    <td>@Html.DisplayFor(modelItem => item.FECHAELABORACION)</td>
                                    <td>
                                        <span class="badge badge-light border text-dark font-weight-bold">
                                            @Html.DisplayFor(modelItem => item.TURNO)
                                        </span>
                                    </td>
                                    <td class="font-weight-bold text-dark">
                                        <i class="fas fa-user text-muted mr-1" style="font-size:0.8rem"></i> @Html.DisplayFor(modelItem => item.NOMBRERESPONSABLE)
                                    </td>
                                    <td class="text-center">
                                        @if (item.ESTADOD == "IMPRESO")
                                        {
                                            <span class="badge bg-success text-white badge-pill-custom shadow-sm">
                                                <i class="fas fa-check-circle mr-1"></i> Impreso
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white badge-pill-custom shadow-sm">
                                                <i class="fas fa-clock mr-1"></i> Pendiente
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill shadow-sm font-weight-bold mr-1" onclick="Consultar('@item.LUGAR', '@item.DEPENDENCIA', '@item.FECHAELABORACION', '@item.TURNO')">
                                                <i class="fas fa-search mr-1"></i> Consulta
                                            </button>
                                            <a class="btn btn-sm btn-outline-secondary rounded-pill shadow-sm font-weight-bold" href="@Url.Action("DescargaIts", "ControlAtcDiario", new { Lugar = item.LUGAR, Dependencia = item.DEPENDENCIA, Fechaelab = item.FECHAELABORACION, Turno = item.TURNO })">
                                                <i class="fas fa-download mr-1"></i> Descarga
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Detalle Ejecutivo -->
    <div class="modal fade" id="largeModal" tabindex="-1" role="dialog" aria-labelledby="largeModal" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title font-weight-bold text-white m-0" id="modalLabel">
                        <i class="fas fa-file-invoice text-primary mr-2"></i> Detalle de Informe Diario ITS
                    </h5>
                    <button type="button" class="close text-white opacity-100" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4 bg-light">
                    
                    <!-- Bloque 1: Datos Generales del Informe -->
                    <div class="card border-0 shadow-sm bg-white mb-3" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-primary m-0"><i class="fas fa-info-circle mr-2"></i>Datos Generales del Informe</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-3 form-group mb-2">
                                    <label class="detail-label">Lugar / ATO</label>
                                    <input class="form-control detail-value detail-value-highlight" id="Lugar" readonly />
                                </div>
                                <div class="col-md-3 form-group mb-2">
                                    <label class="detail-label">Dependencia</label>
                                    <input class="form-control detail-value" id="Dependencia" readonly />
                                </div>
                                <div class="col-md-3 form-group mb-2">
                                    <label class="detail-label">F. Elaboración</label>
                                    <input class="form-control detail-value" id="Fechaelab" readonly />
                                </div>
                                <div class="col-md-3 form-group mb-2">
                                    <label class="detail-label">Turno</label>
                                    <input class="form-control detail-value font-weight-bold text-primary" id="Turno" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bloque 2: Responsables de Turno -->
                    <div class="card border-0 shadow-sm bg-white mb-3" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-primary m-0"><i class="fas fa-user-shield mr-2"></i>Responsables de Turno</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Lic. Resp. Turno Entrante</label>
                                    <input class="form-control detail-value" id="Licresponsable" readonly />
                                </div>
                                <div class="col-md-8 form-group mb-2">
                                    <label class="detail-label">Nombre Responsable Entrante</label>
                                    <input class="form-control detail-value font-weight-bold" id="Nombreresponsable" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Lic. Resp. Turno Saliente</label>
                                    <input class="form-control detail-value" id="Licturnosaliente" readonly />
                                </div>
                                <div class="col-md-8 form-group mb-2">
                                    <label class="detail-label">Nombre Responsable Saliente</label>
                                    <input class="form-control detail-value" id="Nombreresponsablesal" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bloque 3: Controladores de Turno -->
                    <div class="card border-0 shadow-sm bg-white mb-3" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-primary m-0"><i class="fas fa-users mr-2"></i>Detalle de Controladores de Turno</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="table-responsive">
                                <table id="tbDetalleControladores" class="table table-sm table-striped table-hover table-executive mb-0 w-100">
                                    <thead>
                                        <tr>
                                            <th>Licencia</th>
                                            <th>Nombre del Controlador</th>
                                            <th>Vigencia CEMAC</th>
                                            <th class="text-center">Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Bloque 4: NOTAMs -->
                    <div class="card border-0 shadow-sm bg-white mb-3" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-primary m-0"><i class="fas fa-broadcast-tower mr-2"></i>Detalle de NOTAMs</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="table-responsive">
                                <table id="tbDetalleNotams" class="table table-sm table-striped table-hover table-executive mb-0 w-100">
                                    <thead>
                                        <tr>
                                            <th style="width: 150px;">Código NOTAM</th>
                                            <th>Descripción / Detalle</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Bloque 5: Eventos y Novedades -->
                    <div class="card border-0 shadow-sm bg-white mb-3" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-primary m-0"><i class="fas fa-exclamation-triangle mr-2"></i>Detalle de Eventos y Novedades de Bitácora</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="table-responsive">
                                <table id="tbDetalleEventos" class="table table-sm table-striped table-hover table-executive mb-0 w-100">
                                    <thead>
                                        <tr>
                                            <th style="width: 100px;">Hora UTC</th>
                                            <th style="width: 140px;">Evento</th>
                                            <th>Descripción de la Novedad</th>
                                            <th style="width: 180px;">Usuario</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Bloque 6: Operaciones -->
                    <div class="card border-0 shadow-sm bg-white mb-0" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-primary m-0"><i class="fas fa-calculator mr-2"></i>Resumen Consolidado de Operaciones</h6>
                        </div>
                        <div class="card-body p-3">
                            
                            <!-- Panel Costa / Sobrevuelos -->
                            <div class="row" id="costadisplay" style="display: none;">
                                <div class="col-md-6 form-group mb-2">
                                    <label class="detail-label">Sobrevuelos</label>
                                    <input class="form-control detail-value font-weight-bold text-primary" id="SOBREVUELOS" readonly />
                                </div>
                                <div class="col-md-6 form-group mb-2">
                                    <label class="detail-label">Total Operaciones</label>
                                    <input class="form-control detail-value font-weight-bold text-success" id="TOTAL" readonly />
                                </div>
                            </div>

                            <!-- Panel Sierra / Detallado -->
                            <div id="sierradisplay" style="display: none;">
                                <div class="row">
                                    <div class="col-md-2 form-group mb-2">
                                        <label class="detail-label">IFR DEP</label>
                                        <input class="form-control detail-value text-center" id="IFRDEP" readonly />
                                    </div>
                                    <div class="col-md-2 form-group mb-2">
                                        <label class="detail-label">IFR ARR</label>
                                        <input class="form-control detail-value text-center" id="IFRARR" readonly />
                                    </div>
                                    <div class="col-md-2 form-group mb-2">
                                        <label class="detail-label">VFR DEP</label>
                                        <input class="form-control detail-value text-center" id="VFRDEP" readonly />
                                    </div>
                                    <div class="col-md-2 form-group mb-2">
                                        <label class="detail-label">VFR ARR</label>
                                        <input class="form-control detail-value text-center" id="VFRARR" readonly />
                                    </div>
                                    <div class="col-md-2 form-group mb-2">
                                        <label class="detail-label">OVR</label>
                                        <input class="form-control detail-value text-center" id="OVR" readonly />
                                    </div>
                                    <div class="col-md-2 form-group mb-2">
                                        <label class="detail-label">TGL</label>
                                        <input class="form-control detail-value text-center" id="TGL" readonly />
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-md-3 form-group mb-2">
                                        <label class="detail-label">Total IFR</label>
                                        <input class="form-control detail-value font-weight-bold" id="TOTALIFR" readonly />
                                    </div>
                                    <div class="col-md-3 form-group mb-2">
                                        <label class="detail-label">Total VFR</label>
                                        <input class="form-control detail-value font-weight-bold" id="TOTALVFR" readonly />
                                    </div>
                                    <div class="col-md-3 form-group mb-2">
                                        <label class="detail-label">Total DEP</label>
                                        <input class="form-control detail-value font-weight-bold" id="TOTALDEP" readonly />
                                    </div>
                                    <div class="col-md-3 form-group mb-2">
                                        <label class="detail-label">Total ARR</label>
                                        <input class="form-control detail-value font-weight-bold" id="TOTALARR" readonly />
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12 form-group mb-0">
                                        <label class="detail-label">Total General de Operaciones</label>
                                        <input class="form-control detail-value detail-value-highlight text-center font-weight-bold" id="TOTALGENERAL" style="font-size: 1.25rem;" readonly />
