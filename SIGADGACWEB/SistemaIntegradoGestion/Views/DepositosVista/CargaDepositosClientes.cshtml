@model IEnumerable<CapaModelo.tbSubirDepositos>
@{
    ViewBag.Title = "CargaDepositosClientes";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<style>
    /* Azul Institucional DGAC */
    .btn-dgac-blue {
        background-color: #003366;
        color: white;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-dgac-blue:hover {
            background-color: #002244;
            color: #ffcc00; /* Dorado al pasar el mouse */
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

    /* Estilo Outline Ejecutivo */
    .btn-outline-dgac {
        border: 1px solid #003366;
        color: #003366;
        background: transparent;
        font-weight: 500;
    }

        .btn-outline-dgac:hover {
            background-color: #003366;
            color: white;
        }

    /* Ajuste de iconos */
    .btn-sm i {
        margin-right: 5px;
        vertical-align: middle;
    }
    .th-ejecutivo {
        font-size: 1.1rem;
        font-weight: 600;
        text-transform: uppercase;
    }
    .card-title p {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 0;
        color: #007bff;
    }
    .table th {
        background: linear-gradient(to right, #0d6efd, #66b2ff);
        color: white;
        font-size: 13px;
        text-align: center;
    }

    .table td {
        vertical-align: middle;
        font-size: 14px;
    }
</style>
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            @*<div class="col-sm-6">
                    <h2>depositos financieros</h2>
                </div>*@
            @*<div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Inicio </a></li>
                        <li class="breadcrumb-item active">depositos financieros</li>
                    </ol>
                </div>*@
        </div>
    </div><!-- /.container-fluid -->
</section>

<div class="container-fluid">
    <div class="card-header card-header-stretch">
        <div class="card-title d-flex align-items-center">
            <div class="row">
                <div class="card-title">
                    <h4>
                        <p class="text-blue">LISTADO  DEPOSITOS POR COMPAÑIAS </p>
                    </h4>
                </div>

            </div>
        </div>
    </div>


    <br />
    @using (Html.BeginForm("CargaDepositosClientes", "DepositosVista", FormMethod.Post, new { id = "registerForm", enctype = "multipart/form-data", }))
    {

        <div class="row mb-8">
            <div class="col-sm-3">
                <div class="fs-2 fw-bold mt-2 mb-2"><label>CLIENTE</label></div>
            </div>
            <div class="col-sm-4 fv-row">

                <input style="text-transform:uppercase" class="form-control form-control-solid" id="cliente" name="Cliente" />
                @*<input type="date" class="form-control form-control-solid" name="FechaEmision" required>*@

            </div>
            <div>
                @*<a class="btn btn-success" href="CargaDepositosClientes">Buscar</a>*@
                <button type="submit" class="btn btn-sm btn-success" data-dismiss="modal">Buscar </button>


            </div>
        </div>

        <div class="row">

            <div class="col-12">
                <table id="tbDetalle" class="table table-bordered table-hover table-sm"> @*class="table table-bordered table-hover table-sm display" style="width:100%">*@
                    <thead>
                        <tr class="text-sm text-center">
                            <th class="th-ejecutivo">Año</th>
                            <th class="th-ejecutivo">Mes</th>
                            <th class="th-ejecutivo">Ruc</th>
                            <th class="th-ejecutivo">Razon Social</th>
                            <th class="th-ejecutivo">Registros</th>
                            <th colspan="2">Acciones</th>

                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                        <tr class="text-sm text-center">
                            <td>@Html.DisplayFor(modelItem => item.Año)</td>
                            <td>@Html.DisplayFor(modelItem => item.Mes)</td>
                            <td>@Html.DisplayFor(modelItem => item.UsuarioRuc)</td>
                            <td>@Html.DisplayFor(modelItem => item.RazonSocial)</td>
                            <td>@Html.DisplayFor(modelItem => item.Registros)</td>

                            <td class="text-center align-middle">
                                <div class="btn-group" role="group">
                                    @*<a class="btn btn-sm btn-outline-dgac px-3"
                                       href="@Url.Action("SubirDocumentosRecaudacion", "DepositosVista", new { Año = item.Año, Mes = item.Mes, UsuarioRuc = item.UsuarioRuc.ToString(), RazonSocial = item.RazonSocial.ToString() })"
                                       title="Consultar Archivos">
                                        <i class="fas fa-search-doc">
                                            <img src="~/Content/imganes/consultar-documento.png" style="width:16px; filter: contrast(150%);" />
                                        </i>
                                        <span class="d-none d-md-inline">Consultar</span>
                                    </a>*@
                                    <a class="btn btn-sm btn-dgac-blue px-3"
                                       href="@Url.Action("SubirDocumentosRecaudacion", "DepositosVista", new { Año = item.Año, Mes = item.Mes, UsuarioRuc = item.UsuarioRuc.ToString(), RazonSocial = item.RazonSocial.ToString() })"
                                       title="Adjuntar Recibo">
                                        <i class="fas fa-paperclip">
                                            <img src="~/Content/imganes/adjunto.png" style="width:16px; brightness(0) invert(1);" />
                                        </i>
                                        <span class="d-none d-md-inline">Adjuntar RE</span>
                                    </a>
                                </div>
                            </td>


                            @*<td class="text-left">
                                <a id="documentosAdjuntos" class="btn btn-sm  btn-outline-primary" href="@Url.Action("SubirDocumentosDepositos", "DepositosVista", new {Año =item.Año, Mes=item.Mes,UsuarioRuc= item.UsuarioRuc.ToString(),RazonSocial=item.RazonSocial.ToString()})">
                                    <i><img src="~/Content/imganes/consultar-documento.png" style="width:15px" /></i> Consulta archivos
                                </a>
                                <a id="documentosAdjuntos" class="btn btn-sm  btn-outline-primary" href="@Url.Action("SubirDocumentosDepositos", "Depositos", new {Año =item.Año, Mes=item.Mes,UsuarioRuc= item.UsuarioRuc.ToString(),RazonSocial=item.RazonSocial.ToString()})">
                                    <i><img src="~/Content/imganes/adjunto.png" style="width:15px" /></i> Adjuntar RE
                                </a>

                            </td>*@

                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="modal fade" id="largeModal" tabindex="-1" role="dialog" aria-labelledby="largeModal" aria-hidden="true">


            <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
                <div class="modal-content">

                    <div class="modal-header bg-gradient-primary text-white">
                        <h6 class="modal-title text-white" id="modalLabel"> INFORME DIARIO ITS</h6>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>


        </div>
    }

</div>


@section scripts{
    <script>
        $(document).ready(function () {

        });

        function modalAdjunto() {
            $('#FormModal').modal('show');
        }






    </script>
}
