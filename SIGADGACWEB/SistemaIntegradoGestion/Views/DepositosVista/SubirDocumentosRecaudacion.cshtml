@model CapaModelo.tbSubirDepositos

@{
    ViewBag.Title = "Documentos Financieros";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>

    .celda-recortada {
        max-width: 200px; /* Ajusta el ancho según necesites */
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    /* Sombra suave para las tarjetas */
    .shadow-sm {
        box-shadow: 0 .125rem .25rem rgba(0,0,0,.075) !important;
    }

    /* Ajuste de la tabla */
    .table thead th {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
        border-top: none;
    }

    .celda-recortada {
        max-width: 200px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Estilo para inputs deshabilitados para que no parezcan "muertos" */
    .form-control:disabled {
        background-color: #f8f9fa;
        cursor: not-allowed;
    }

    /* Mejora visual del visor de PDF */
    #iframeCetificado {
        background-color: #525659; /* Color gris oscuro típico de visores PDF */
    }
    .nombre-archivo-recortado {
        max-width: 150px; /* Ajusta este ancho según tu preferencia */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: inline-block;
        vertical-align: middle;
    }
</style>
<section>
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h2>Carga/Descarga Dtos.Depositos-Recaudacion</h2>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">@Session["ActionResul"]</li>
                    <li class="breadcrumb-item active">DocumentosClientes</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
    <div class="card-header card-header-stretch">
        <div class="card-title d-flex align-items-center">
            <div class="row">
                @*<div class="col-md-9">
                        <h3 class="fw-bolder m-0 text-gray-800">
                            Detalle Garantías
                        </h3>
                    </div>*@
                <div class="col-md-12">
                    <a class="btn btn-success" href="CargaDepositosClientes">Inicio</a>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container-fluid">
    @using (Html.BeginForm("SubirDocumentosRecaudacion", "DepositosVista", FormMethod.Post, new { id = "registerForm", enctype = "multipart/form-data", }))
    {

        <input type="hidden" id="Directory" name="Directory" value="@ViewBag.DireccionDirectory" />
        @Html.HiddenFor(m => m.Año)
        @Html.HiddenFor(m => m.Mes)
        @Html.HiddenFor(m => m.UsuarioRuc)
        @Html.HiddenFor(m => m.RazonSocial)


        <div class="row">
            <div class="col-12 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title mb-0 text-primary"><i class="fas fa-folder-open mr-2"></i> Archivos Depositados/Recaudados</h5>
                    </div>
                    <div class="col-md-6 text-md-right mt-2 mt-md-0">
                        <span class="badge badge-light border px-3 py-2 mr-1">
                            <strong class="text-muted">RUC:</strong> @Model.UsuarioRuc
                        </span>
                        <span class="badge badge-light border px-3 py-2 mr-1">
                            <strong class="text-muted">Periodo:</strong> @Model.Año - @Model.Mes
                        </span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table id="tbExploradorArchivos" class="table table-hover mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Nombre archivo</th>
                                        <th>Comprobante/Transferencia/Recaudacion</th>
                                        <th>Fecha Deposito/Recaudacion</th>
                                        <th>Concepto</th>
                                        <th class="text-right">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.oModelArchivo != null)
                                    {
                                        foreach (var item in Model.oModelArchivo)
                                        {
                                            <tr>

                                                <td class="align-middle">
                                                    <a href="#"
                                                       class="nombre-archivo-recortado font-weight-bold text-info"
                                                       title="@item.NombreArchivo"
                                                       onclick="abrirArchivo(JSON.stringify('@item.NombreArchivo'));">
                                                        <i class="far fa-file-pdf mr-1"></i> @item.NombreArchivo
                                                    </a>
                                                </td>

                                                <td class="align-middle">@item.Comprobante</td>
                                                <td class="align-middle">@item.FechaDeposito</td>
                                                <td class="align-middle celda-recortada" title="@item.Concepto">
                                                    <span class="text-muted small">@item.Concepto</span>
                                                </td>
                                                <td class="text-right align-middle">
                                                    <a id="eliminar" href="#" onclick="eliminar(JSON.stringify('@item.NombreArchivo'));">
                                                        <i>
                                                            <img src="~/Content/imganes/eliminar1.png" style="width:25px" />
                                                        </i>
                                                        Eliminar
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-5">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3">
                        <h6 class="m-0 font-weight-bold">Nuevo Registro</h6>
                    </div>
                    <div class="card-body">
                        @*<div class="alert alert-warning p-2 mb-3" style="font-size: 0.85rem;">
                            <strong>Nota:</strong> El nombre del archivo debe ser el número de depósito y fecha.
                        </div>*@

                        <div class="form-group">
                            <label class="small font-weight-bold">Documento Recaudacion (PDF)</label>
                            <div class="custom-file">
                                <input type="file" class="custom-file-input" id="documentFile" name="documentFile">
                                <label id="labelFile" class="custom-file-label text-truncate" for="documentFile">Elegir archivo...</label>
                            </div>
                            <small class="text-muted">Máx. 4 MB</small>
                        </div>

                        <div class="form-group">
                            <label class="small font-weight-bold">Nro. Documento RE</label>
                            <input type="text" class="form-control form-control-sm" id="comprobante" name="comprobante" placeholder="000000" disabled>
                        </div>

                        <div class="form-group">
                            <label class="small font-weight-bold">Fecha Recaudacion</label>
                            <input type="date" class="form-control form-control-sm" id="fechadeposito" name="fechadeposito" disabled>
                        </div>

                        <div class="form-group">
                            <label class="small font-weight-bold">Concepto</label>
                            <textarea class="form-control form-control-sm" id="concepto" name="concepto" rows="3" placeholder="..." disabled></textarea>
                        </div>
                    </div>
                    <div class="card-footer bg-light border-0">
                        <button id="btnEnviar" class="btn btn-primary btn-block shadow-sm">
                            <img src="~/Content/imganes/save.png" style="width:18px" class="mr-2" /> Grabar Información
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-lg-8 col-md-7 mt-3 mt-md-0">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body p-0 bg-dark d-flex align-items-center justify-content-center" style="min-height: 500px; border-radius: 4px; overflow: hidden;">
                        <iframe id="iframeCetificado" class="w-100 h-100" style="border: none; height: 75vh !important;"></iframe>
                    </div>
                </div>
            </div>
        </div>

        <div id="loadingBuscar" class="position-fixed w-100 h-100" style="display:none; top:0; left:0; background: rgba(255,255,255,0.7); z-index: 9999;">
            <div class="d-flex justify-content-center align-items-center h-100">
                <img src="~/Content/imganes/loadingHorizontal.gif" />
            </div>
        </div>




        if (@ViewBag.mensajeError != null)
        {
            if (@ViewBag.mensajeError.Length > 0)
            {
                <script type="text/javascript">
                    window.onload = function () {
                        Swal.fire({
                            title: "",
                            text: set(@Html.Raw(Json.Encode(@ViewBag.mensajeError))),
                            icon: "warning",
                            showCancelButton: false,
                            confirmButtonColor: '#3085d6',
                            confirmButtonText: 'Aceptar',
                            allowOutsideClick: false,
                        });
                    };
                   function set(value) {
                        return value;
                   }
                </script>
            }

        }
    }
</div>
@section scripts{
    <script src="@Url.Content("~/Scripts/Views/Depositos/SubirDepositos.js")" type="text/javascript">


    </script>


}

