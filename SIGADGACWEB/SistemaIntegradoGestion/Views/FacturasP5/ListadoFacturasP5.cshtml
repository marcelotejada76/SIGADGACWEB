@model IEnumerable<CapaModelo.tbFacturasP5>
@{
    ViewBag.Title = "Listado de Facturas P5";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var totalFacturas = Model != null ? Model.Count() : 0;
    var totalClientes = Model != null ? Model.Select(x => x.NOMBRECLIENTE).Where(c => !string.IsNullOrEmpty(c)).Distinct().Count() : 0;
    var montoTotal = Model != null ? Model.Sum(x => x.VALORFACTURA) : 0m;

    var resumenClientes = Model != null ? Model
        .GroupBy(x => string.IsNullOrEmpty(x.NOMBRECLIENTE) ? "N/A" : x.NOMBRECLIENTE)
        .Select(g => new {
            Cliente = g.Key,
            Cantidad = g.Count(),
            MontoTotal = g.Sum(x => x.VALORFACTURA)
        })
        .OrderByDescending(x => x.Cantidad)
        .ToList() : null;
}

<style>
    .card-kpi {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 10px;
    }
    .card-kpi:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 15px rgba(0,0,0,0.08) !important;
    }
    .badge-pill-custom {
        padding: 0.5em 0.85em;
        font-size: 0.82rem;
        font-weight: 600;
        border-radius: 50rem;
    }
    .table-executive thead th {
        background-color: #1a2226;
        color: #ffffff;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: none;
        padding: 12px 15px;
    }
    .table-executive tbody td {
        vertical-align: middle;
        padding: 12px 15px;
        font-size: 0.9rem;
    }
    .detail-label {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #6c757d;
        letter-spacing: 0.5px;
        margin-bottom: 0.35rem;
    }
    .detail-value {
        font-size: 0.92rem;
        font-weight: 600;
        color: #212529;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        padding: 8px 12px;
        height: auto;
    }
    .detail-value-highlight {
        background-color: #eaf2fd;
        border-color: #b6d4fe;
        color: #004085;
        font-weight: 700;
    }
</style>

<div class="container-fluid pt-3">

    <!-- Header Principal -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="mb-2 mb-md-0">
            <h2 class="font-weight-bold text-dark mb-1" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                <i class="fas fa-file-invoice-dollar text-primary mr-2"></i> Tablero Ejecutivo de Facturas P5
            </h2>
            <p class="text-muted mb-0 small">
                Monitoreo consolidado de facturación, recaudación y clientes
            </p>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row mb-4">
        <!-- Total Facturas -->
        <div class="col-xl-4 col-md-4 col-sm-12 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #0056b3 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Total Facturas</span>
                            <h3 class="mb-0 font-weight-bold text-dark mt-1">@totalFacturas</h3>
                        </div>
                        <div class="rounded-circle bg-light p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-file-invoice text-primary fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Clientes Únicos -->
        <div class="col-xl-4 col-md-4 col-sm-12 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #6f42c1 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Clientes Únicos</span>
                            <h3 class="mb-0 font-weight-bold mt-1" style="color: #6f42c1;">@totalClientes</h3>
                        </div>
                        <div class="rounded-circle bg-light p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-building fa-lg" style="color: #6f42c1;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Monto Total Facturado -->
        <div class="col-xl-4 col-md-4 col-sm-12 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #28a745 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Monto Total Facturado</span>
                            <h3 class="mb-0 font-weight-bold text-success mt-1">$@montoTotal.ToString("N2")</h3>
                        </div>
                        <div class="rounded-circle bg-light p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-dollar-sign text-success fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Totales por Cliente -->
    @if (resumenClientes != null && resumenClientes.Any())
    {
        <div class="card border-0 shadow-sm rounded-lg mb-4">
            <div class="card-header bg-white py-2 border-bottom d-flex align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-dark" style="font-size: 0.95rem;">
                    <i class="fas fa-building text-primary mr-2"></i> Resumen de Facturación por Cliente
                </h6>
                <span class="badge badge-light border rounded-pill px-3 py-1 font-weight-bold text-primary" style="font-size: 0.8rem;">
                    <i class="fas fa-building mr-1"></i> @resumenClientes.Count Cliente(s)
                </span>
            </div>
            <div class="card-body p-3 bg-light">
                <div class="d-flex flex-wrap align-items-center" style="gap: 12px;">
                    @foreach (var cli in resumenClientes)
                    {
                        <div class="card border-0 shadow-sm bg-white px-3 py-2" style="border-radius: 10px; min-width: 240px; border-left: 4px solid #007bff !important;">
                            <div class="d-flex align-items-center justify-content-between">
                                <div style="max-width: 160px;">
                                    <span class="text-uppercase text-muted font-weight-bold small d-block mb-1 text-truncate" title="@cli.Cliente">
                                        <i class="fas fa-building text-primary mr-1"></i> @cli.Cliente
                                    </span>
                                    <h5 class="mb-0 font-weight-bold text-dark" style="font-size: 1.1rem;">
                                        @cli.Cantidad <span class="small text-muted font-weight-normal">fact.</span>
                                    </h5>
                                </div>
                                <span class="badge badge-light border text-success font-weight-bold ml-2 px-2 py-1" style="border-radius: 12px;">
                                    $@cli.MontoTotal.ToString("N2")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Card Filtro de Búsqueda -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-body p-3">
            @using (Html.BeginForm("ListadoFacturasP5", "FacturasP5", FormMethod.Post, new { id = "registerForm", enctype = "multipart/form-data" }))
            {
                <div class="row align-items-center">
                    <div class="col-md-3 mb-2 mb-md-0">
                        <label class="font-weight-bold text-muted mb-0 small text-uppercase" style="letter-spacing: 0.5px;">
                            <i class="fas fa-search mr-1 text-primary"></i> Cliente / Nro. Factura
                        </label>
                    </div>
                    <div class="col-md-6 mb-2 mb-md-0">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-light border-right-0"><i class="fas fa-file-invoice text-muted"></i></span>
                            </div>
                            <input type="text" style="text-transform:uppercase" class="form-control border-left-0" id="NombreCliente" name="NombreCliente" placeholder="Ingrese nombre de cliente o número de factura..." required />
                        </div>
                    </div>
                    <div class="col-md-3 text-md-right">
                        <button type="submit" class="btn btn-primary btn-block rounded-pill shadow-sm font-weight-bold">
                            <i class="fas fa-search mr-1"></i> Buscar Facturas
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main Table Executive Card -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="card-title m-0 font-weight-bold text-dark" style="font-size: 1.05rem;">
                <i class="fas fa-list-ul text-primary mr-2"></i> Listado Registrado de Facturas P5
            </h5>
            <span class="badge badge-light border px-3 py-2 font-weight-normal" style="border-radius: 20px;">
                <i class="fas fa-layer-group text-primary mr-1"></i> @totalFacturas Registros
            </span>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="tbDetalle" class="table table-hover table-striped table-executive w-100">
                    <thead>
                        <tr>
                            <th><i class="fas fa-building mr-1"></i> Nombre Cliente</th>
                            <th><i class="fas fa-id-card mr-1"></i> Cédula / RUC</th>
                            <th><i class="fas fa-file-invoice mr-1"></i> Factura</th>
                            <th class="text-right"><i class="fas fa-dollar-sign mr-1"></i> Valor</th>
                            <th><i class="fas fa-calendar-alt mr-1"></i> Fecha Creación</th>
                            <th class="text-center"><i class="fas fa-cogs mr-1"></i> Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="font-weight-bold text-dark">@Html.DisplayFor(modelItem => item.NOMBRECLIENTE)</td>
                                    <td>
                                        <span class="badge badge-light border text-dark font-weight-bold px-2 py-1">
                                            @Html.DisplayFor(modelItem => item.CEDULA_RUC)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge badge-light border text-primary font-weight-bold px-2 py-1">
                                            <i class="fas fa-hashtag text-muted mr-1"></i> @Html.DisplayFor(modelItem => item.NUMEROFACTURA)
                                        </span>
                                    </td>
                                    <td class="text-right font-weight-bold text-success">$@Html.DisplayFor(modelItem => item.VALORFACTURA)</td>
                                    <td>@Html.DisplayFor(modelItem => item.FECHACREA)</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill shadow-sm font-weight-bold" onclick="Consultar('@item.OIDFACTURA')">
                                            <i class="fas fa-search mr-1"></i> Consulta
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Detalle Ejecutivo -->
    <div class="modal fade" id="largeModal" tabindex="-1" role="dialog" aria-labelledby="largeModal" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title font-weight-bold text-white m-0" id="modalLabel">
                        <i class="fas fa-file-invoice-dollar text-primary mr-2"></i> Detalle de Factura P5
                    </h5>
                    <button type="button" class="close text-white opacity-100" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4 bg-light">
                    
                    <!-- Bloque 1: Información General del Cliente y Factura -->
                    <div class="card border-0 shadow-sm bg-white mb-3" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-primary m-0"><i class="fas fa-info-circle mr-2"></i>Datos del Cliente y Factura</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Compañía / Cliente</label>
                                    <input class="form-control detail-value detail-value-highlight" id="NOMBRECLIENTE" readonly />
                                </div>
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Cédula / RUC</label>
                                    <input class="form-control detail-value font-weight-bold" id="CEDULA_RUC" readonly />
                                </div>
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Estado</label>
                                    <input class="form-control detail-value font-weight-bold text-primary" id="ESTADO" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Número Factura</label>
                                    <input class="form-control detail-value font-weight-bold text-primary" id="NUMEROFACTURA" readonly />
                                </div>
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Valor Factura</label>
                                    <input class="form-control detail-value font-weight-bold text-success" id="VALORFACTURA" readonly />
                                </div>
                                <div class="col-md-4 form-group mb-2">
                                    <label class="detail-label">Usuario Crea</label>
                                    <input class="form-control detail-value" id="USUARIO" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3 form-group mb-2">
                                    <label class="detail-label">Fecha Creación</label>
                                    <input class="form-control detail-value" id="FECHACREACION" readonly />
                                </div>
                                <div class="col-md-3 form-group mb-2">
                                    <label class="detail-label">Nombre</label>
                                    <input class="form-control detail-value" id="NOMBRE" readonly />
                                </div>
                                <div class="col-md-3 form-group mb-2">
                                    <label class="detail-label">Lugar</label>
                                    <input class="form-control detail-value" id="LUGAR" readonly />
                                </div>
                                <div class="col-md-3 form-group mb-2">
                                    <label class="detail-label">Departamento</label>
                                    <input class="form-control detail-value" id="DEPARTAMENTO" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bloque 2: Detalle de Conceptos de Factura -->
                    <div class="card border-0 shadow-sm bg-white mb-3" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-primary m-0"><i class="fas fa-list-ol mr-2"></i>Detalle de Conceptos de Factura</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="table-responsive">
                                <table id="tbDetalleFactura" class="table table-sm table-striped table-hover table-executive mb-0 w-100">
                                    <thead>
                                        <tr>
                                            <th>Código Contable</th>
                                            <th>Concepto / Descripción</th>
                                            <th class="text-right">Valor ($)</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Bloque 3: Detalle de Recaudación -->
                    <div class="card border-0 shadow-sm bg-white mb-0" style="border-radius: 8px;">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="font-weight-bold text-primary m-0"><i class="fas fa-receipt mr-2"></i>Detalle de Recaudación</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="table-responsive">
                                <table id="tbDetalleRecaudacion" class="table table-sm table-striped table-hover table-executive mb-0 w-100">
                                    <thead>
                                        <tr>
                                            <th>Fecha CR</th>
                                            <th>Usuario / Responsable</th>
                                            <th>Fecha Anulación</th>
                                            <th>Código</th>
                                            <th>Concepto</th>
                                            <th class="text-right">Valor Recaudado ($)</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer bg-white border-top py-2">
                    <button type="button" class="btn btn-secondary px-4 rounded-pill font-weight-bold" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts{
    <script>
        $(document).ready(function () {
            if ($.fn.dataTable.isDataTable('#tbDetalle')) {
                $('#tbDetalle').DataTable().destroy();
            }

            $('#tbDetalle').DataTable({
                "responsive": true,
                "autoWidth": false,
                "pageLength": 10,
                "language": {
                    "sProcessing":     "Procesando...",
                    "sLengthMenu":     "Mostrar _MENU_ registros",
                    "sZeroRecords":    "No se encontraron resultados",
                    "sEmptyTable":     "Ningún dato disponible en esta tabla",
                    "sInfo":           "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                    "sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
                    "sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
                    "sSearch":         "Buscar:",
                    "oPaginate": {
                        "sFirst":    "Primero",
                        "sLast":     "Último",
                        "sNext":     "Siguiente",
                        "sPrevious": "Anterior"
                    }
                }
            });
        });

        function modalAdjunto() {
            $('#FormModal').modal('show');
        }

        function Consultar(Oid) {
            $("#NOMBRECLIENTE").val("");
            $("#CEDULA_RUC").val("");
            $("#ESTADO").val("");
            $("#NUMEROFACTURA").val("");
            $("#CODIGO").val("");
            $("#VALORFACTURA").val("");
            $("#USUARIO").val("");
            $("#FECHACREACION").val("");
            $("#NOMBRE").val("");
            $("#LUGAR").val("");
            $("#DEPARTAMENTO").val("");
            $("#tbDetalleFactura tbody").html("");
            $("#tbDetalleRecaudacion tbody").html("");

            $.ajax({
                url: $.MisUrls.url._DetalleFacturaP5,
                type: "GET",
                contentType: "application/json;charset=UTF-8",
                dataType: "json",
                data: { OidFactura: Oid },
                success: function (e) {
                    $("#NOMBRECLIENTE").val(e.NOMBRECLIENTE);
                    $("#CEDULA_RUC").val(e.CEDULA_RUC);
                    $("#ESTADO").val(e.ESTADO);
                    $("#NUMEROFACTURA").val(e.NUMEROFACTURA);
                    $("#CODIGO").val(e.CODIGO);
                    $("#VALORFACTURA").val(e.VALORFACTURA);
                    $("#USUARIO").val(e.USUARIOCREA);
                    $("#FECHACREACION").val(e.FECHACREACION);
                    $("#NOMBRE").val(e.NOMBRE);
                    $("#LUGAR").val(e.APELLIDO);
                    $("#DEPARTAMENTO").val(e.DEPARTAMENTO);
                    
                    $("#tbDetalleFactura tbody").html("");
                    $.each(e.oDetalleFactura, function (i, row) {
                        $("<tr>").append(
                            $("<td>").html('<span class="font-weight-bold text-primary">' + row["CODIGOCONTABLE"] + '</span>'),
                            $("<td>").text(row["DESCRIPCION"]),
                            $("<td class='text-right font-weight-bold text-success'>").text(row["VALOR"])
                        ).appendTo("#tbDetalleFactura tbody");
                    });

                    $("#tbDetalleRecaudacion tbody").html("");
                    $.each(e.oDetalleRecaudacion, function (i, row) {
                        $("<tr>").append(
                            $("<td>").text(row["FECHARECAUDACION"]),
                            $("<td>").text((row["USUARIO"] || "") + " " + (row["NOMBRE"] || "") + " " + (row["APELLIDO"] || "") + " " + (row["DEPARTAMENTO"] || "")),
                            $("<td>").text(row["FECHAANULACION"]),
                            $("<td>").html('<span class="badge badge-light border text-primary font-weight-bold">' + row["CODIGO"] + '</span>'),
                            $("<td>").text(row["CONCEPTO"]),
                            $("<td class='text-right font-weight-bold text-success'>").text(row["VALORRECAUDADO"])
                        ).appendTo("#tbDetalleRecaudacion tbody");
                    });
                },
                error: function (errormessage) {
                    Swal.fire("Mensaje", "Financiero: " + errormessage, "warning");
                }
            });

            $('#largeModal').modal('show');
        }
    </script>
}
