@model SistemaIntegradoGestion.Models.ModelLogin
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon icon -->
    <link rel="icon" type="image/png" sizes="16x16" href="~/Content/imganes/logo2.jpg" />
    <title>DGAC | Login</title>
    
    <!-- Bootstrap & SweetAlert -->
    <link href="@Url.Content("~/Content/bootstrap.min.css")" rel="stylesheet" id="bootstrap-css">
    <link href="@Url.Content("~/Content/Plugins/sweetalert2/sweetalert2.min.css")" rel="stylesheet" />
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Custom Login CSS -->
    <link href="@Url.Content("~/Content/logincontainer.css?v=" + DateTime.Now.Ticks)" rel="stylesheet" />
</head>
<body class="login-page">
    <div class="login-wrapper">
        <!-- Left Side: Image/Branding -->
        <div class="login-visual">
            <div class="visual-overlay"></div>
            <div class="visual-content">
                <h2>Sistema Integrado de Gesti&oacute;n  SIGDGAC</h2>
                <p>Direcci&oacute;n General de Aviaci&oacute;n Civil</p>
            </div>
        </div>

        <!-- Right Side: Form -->
        <div class="login-panel">
            <div class="login-form-container">
                <div class="login-header">
                    <img src="~/Content/imganes/logodgac.jpg" alt="Logo DGAC" class="login-logo" />
                    <h3>Bienvenido</h3>
                    <p class="text-muted">Ingrese sus credenciales para continuar</p>
                </div>
                
                @using (Html.BeginForm("login", "Login", FormMethod.Post, new { id = "loginForm", enctype = "multipart/form-data", @class = "modern-form" }))
                {
                    <div class="form-group modern-input-group">
                        <label for="Usuario">Usuario *</label>
                        @Html.TextBoxFor(model => model.Usuario, new { @class = "form-control text-uppercase", autocomplete = "off", maxlength = "10" })
                    </div>
                    
                    <div class="form-group modern-input-group">
                        <label for="Clave">Contrase&ntilde;a *</label>
                        @Html.TextBoxFor(model => model.Clave, new { @class = "form-control text-uppercase", @type = "password", autocomplete = "off", maxlength = "10" })
                    </div>
                    
                    <button type="submit" class="btn btn-primary btn-login">Ingresar</button>

                    if (Model.Mensaje != null)
                    {
                        if (Model.Mensaje.Length > 0)
                        {
                            <script type="text/javascript">
                                window.onload = function () {
                                    Swal.fire("Login-Usuario", set(@Html.Raw(Json.Encode(Model.Mensaje))), "warning");
                                };
                                function set(value) {
                                    return value;
                                }
                            </script>
                        }
                    }
                }
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/Scripts/jquery-3.3.1.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Content/Plugins/sweetalert2/sweetalert2.min.js"></script>
</body>
</html>
