@model IEnumerable<CapaModelo.tbMatriculas>
@{
    ViewBag.Title = "Listado de Matrículas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totalMatriculas = Model != null ? Model.Count() : 0;
}

<style>
    .badge-pill-custom {
        padding: 0.5em 0.85em;
        font-size: 0.82rem;
        font-weight: 600;
        border-radius: 50rem;
    }
    .table-executive thead th {
        background-color: #1a2226;
        color: #ffffff;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: none;
        padding: 12px 15px;
    }
    .table-executive tbody td {
        vertical-align: middle;
        padding: 12px 15px;
        font-size: 0.9rem;
    }
    .detail-modal-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #6c757d;
        letter-spacing: 0.5px;
        margin-bottom: 0.25rem;
    }
</style>

<div class="container-fluid pt-3">

    <!-- Header Principal -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="mb-2 mb-md-0">
            <h2 class="font-weight-bold text-dark mb-1" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                <i class="fas fa-plane-departure text-primary mr-2"></i> Matrículas
            </h2>
            <p class="text-muted mb-0 small">
                Monitoreo y consulta consolidada de matrículas de aeronaves y compañías de aviación
            </p>
        </div>
    </div>

    <!-- Search Form Card -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-body p-3">
            @using (Html.BeginForm("ListadoMatriculaP5", "Matriculas", FormMethod.Post, new { id = "registerForm", enctype = "multipart/form-data" }))
            {
                <div class="row align-items-center">
                    <div class="col-md-3 col-sm-12 mb-2 mb-md-0">
                        <label class="font-weight-bold text-muted small text-uppercase mb-0">
                            <i class="fas fa-search mr-1"></i> Búsqueda por Compañía / Matrícula
                        </label>
                    </div>
                    <div class="col-md-6 col-sm-12 mb-2 mb-md-0">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-light border-right-0"><i class="fas fa-font text-muted"></i></span>
                            </div>
                            <input style="text-transform:uppercase" class="form-control border-left-0" id="NombreCompania" name="NombreCompania" placeholder="Ingrese nombre de Compañía o Matrícula..." />
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-12 text-md-right">
                        <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm font-weight-bold">
                            <i class="fas fa-search mr-1"></i> Buscar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main Table Executive Card -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="card-title m-0 font-weight-bold text-dark" style="font-size: 1.05rem;">
                <i class="fas fa-list-ul text-primary mr-2"></i> Registro Consolidado de Matrículas
            </h5>
            <span class="badge badge-light border px-3 py-2 font-weight-normal" style="border-radius: 20px;">
                <i class="fas fa-layer-group text-primary mr-1"></i> @totalMatriculas Registros
            </span>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="tbDetalle" class="table table-hover table-striped table-executive w-100">
                    <thead>
                        <tr>
                            <th><i class="fas fa-building mr-1"></i> Compañía</th>
                            <th><i class="fas fa-plane mr-1"></i> Matrícula</th>
                            <th class="text-center"><i class="fas fa-toggle-on mr-1"></i> Estado</th>
                            <th><i class="fas fa-tag mr-1"></i> Uso</th>
                            <th><i class="fas fa-weight-hanging mr-1"></i> Peso MTOW</th>
                            <th class="text-center"><i class="fas fa-cogs mr-1"></i> Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var estadoUpper = item.ESTADO != null ? item.ESTADO.Trim().ToUpper() : "";

                            <tr>
                                <td class="font-weight-bold text-dark">
                                    <i class="fas fa-building text-muted mr-1" style="font-size:0.85rem"></i> @Html.DisplayFor(modelItem => item.COMPAÑIA)
                                </td>
                                <td>
                                    <span class="badge badge-light border text-primary font-weight-bold px-2 py-1" style="font-size:0.9rem">
                                        <i class="fas fa-plane-departure mr-1"></i> @Html.DisplayFor(modelItem => item.MATRICULA)
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (estadoUpper == "ACTIVO")
                                    {
                                        <span class="badge bg-success text-white badge-pill-custom shadow-sm">
                                            <i class="fas fa-check-circle mr-1"></i> @item.ESTADO
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white badge-pill-custom shadow-sm">
                                            <i class="fas fa-minus-circle mr-1"></i> @(string.IsNullOrEmpty(item.ESTADO) ? "INACTIVO" : item.ESTADO)
                                        </span>
                                    }
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.USO)</td>
                                <td>
                                    <span class="font-weight-bold text-dark">@Html.DisplayFor(modelItem => item.PESOMAXESTRUCTURAL)</span>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary px-3 rounded-pill shadow-sm font-weight-bold" onclick="Consultar(@item.OID)">
                                        <i class="fas fa-search mr-1"></i> Ver Detalle
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Detalle Ejecutivo -->
<div class="modal fade" id="largeModal" tabindex="-1" role="dialog" aria-labelledby="largeModal" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content border-0 shadow-lg rounded-lg">
            <div class="modal-header bg-gradient-primary text-white py-3">
                <h5 class="modal-title font-weight-bold" id="modalLabel">
                    <i class="fas fa-plane mr-2"></i> Detalle de Matrícula
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="detail-modal-label"><i class="fas fa-building mr-1"></i> Compañía</label>
                        <input class="form-control font-weight-bold text-dark bg-light" id="COMPAÑIA" readonly="readonly" />
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="detail-modal-label"><i class="fas fa-id-card mr-1"></i> RUC</label>
                        <input class="form-control font-weight-bold text-dark bg-light" id="RUC" readonly="readonly" />
                    </div>

                    <div class="col-md-4 form-group mb-3">
                        <label class="detail-modal-label"><i class="fas fa-plane mr-1"></i> Matrícula</label>
                        <input class="form-control font-weight-bold text-primary bg-light" id="MATRICULA" readonly="readonly" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="detail-modal-label"><i class="fas fa-copyright mr-1"></i> Marca</label>
                        <input class="form-control font-weight-bold text-dark bg-light" id="MARCA" readonly="readonly" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="detail-modal-label"><i class="fas fa-layer-group mr-1"></i> Modelo</label>
                        <input class="form-control font-weight-bold text-dark bg-light" id="MODELO" readonly="readonly" />
                    </div>

                    <div class="col-md-4 form-group mb-3">
                        <label class="detail-modal-label"><i class="fas fa-toggle-on mr-1"></i> Estado</label>
                        <input class="form-control font-weight-bold text-success bg-light" id="ESTADO" readonly="readonly" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="detail-modal-label"><i class="fas fa-tag mr-1"></i> Uso</label>
                        <input class="form-control font-weight-bold text-dark bg-light" id="USO" readonly="readonly" />
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label class="detail-modal-label"><i class="fas fa-barcode mr-1"></i> Designador</label>
                        <input class="form-control font-weight-bold text-dark bg-light" id="DESIGNADOR" readonly="readonly" />
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label class="detail-modal-label"><i class="fas fa-weight-hanging mr-1"></i> Peso Máximo Estructural (MTOW)</label>
                        <input class="form-control font-weight-bold text-dark bg-light" id="PESO" readonly="readonly" />
                    </div>

                    <div class="col-12"><hr class="my-2" /></div>

                    <div class="col-md-6 form-group mb-3">
                        <label class="detail-modal-label">Fecha de Creación</label>
                        <input class="form-control small bg-light" id="FECHACREA" readonly="readonly" />
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="detail-modal-label">Usuario Creador</label>
                        <input class="form-control small bg-light" id="USUARIOCREA" readonly="readonly" />
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label class="detail-modal-label">Fecha de Modificación</label>
                        <input class="form-control small bg-light" id="FECHAMODIFICA" readonly="readonly" />
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="detail-modal-label">Usuario Modificador</label>
                        <input class="form-control small bg-light" id="USUARIOMODIFICA" readonly="readonly" />
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4 rounded-pill font-weight-bold" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            if ($.fn.dataTable.isDataTable('#tbDetalle')) {
                $('#tbDetalle').DataTable().destroy();
            }

            $('#tbDetalle').DataTable({
                "responsive": true,
                "autoWidth": false,
                "pageLength": 10,
                "language": {
                    "sProcessing":     "Procesando...",
                    "sLengthMenu":     "Mostrar _MENU_ registros",
                    "sZeroRecords":    "No se encontraron resultados",
                    "sEmptyTable":     "Ningún dato disponible en esta tabla",
                    "sInfo":           "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                    "sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
                    "sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
                    "sSearch":         "Buscar:",
                    "oPaginate": {
                        "sFirst":    "Primero",
                        "sLast":     "Último",
                        "sNext":     "Siguiente",
                        "sPrevious": "Anterior"
                    }
                }
            });
        });

        function Consultar(Oid) {
            $.ajax({
                url: $.MisUrls.url._DetalleMatriculaP5,
                type: "GET",
                contentType: "application/json;charset=UTF-8",
                dataType: "json",
                data: { OidMatricula: Oid },
                success: function (e) {
                    $("#COMPAÑIA").val(e.COMPAÑIA);
                    $("#RUC").val(e.RUC);
                    $("#MATRICULA").val(e.MATRICULA);
                    $("#MARCA").val(e.MARCA);
                    $("#MODELO").val(e.MODELO);
                    $("#ESTADO").val(e.ESTADO);
                    $("#USO").val(e.USO);
                    $("#DESIGNADOR").val(e.DESIGNADOR);
                    $("#FECHACREA").val(e.FECHACREA);
                    $("#USUARIOCREA").val(e.USUARIOCREA);
                    $("#FECHAMODIFICA").val(e.FECHAMODIFICA);
                    $("#USUARIOMODIFICA").val(e.USUARIOMODIFICA);
                    $("#PESO").val(e.PESOMAXESTRUCTURAL);
                },
                error: function (errormessage) {
                    Swal.fire("Mensaje", "Error al cargar detalle: " + errormessage, "warning");
                }
            });

            $('#largeModal').modal('show');
        }
    </script>
}
