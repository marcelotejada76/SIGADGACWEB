@model IEnumerable<CapaModelo.tbMatriculasAdeudadas>
@{
    ViewBag.Title = "Listado de Matrículas Adeudadas";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var totalMatriculas = Model != null ? Model.Count() : 0;
    var totalMontoFactura = Model != null ? Model.Sum(x => x.VALORFACTURA) : 0;
    var totalSaldoAdeudado = Model != null ? Model.Sum(x => x.VALORSALDO) : 0;
    var totalCompanias = Model != null ? Model.Select(x => x.COMPAÑIA).Where(c => !string.IsNullOrEmpty(c)).Distinct().Count() : 0;
}

<style>
    .card-kpi {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 10px;
    }
    .card-kpi:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 15px rgba(0,0,0,0.08) !important;
    }
    .badge-pill-custom {
        padding: 0.5em 0.85em;
        font-size: 0.82rem;
        font-weight: 600;
        border-radius: 50rem;
    }
    .table-executive thead th {
        background-color: #1a2226;
        color: #ffffff;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: none;
        padding: 12px 15px;
    }
    .table-executive tbody td {
        vertical-align: middle;
        padding: 12px 15px;
        font-size: 0.9rem;
    }
    .detail-label {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #6c757d;
        letter-spacing: 0.5px;
        margin-bottom: 0.35rem;
    }
    .detail-value {
        font-size: 0.92rem;
        font-weight: 600;
        color: #212529;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        padding: 8px 12px;
        height: auto;
    }
    .detail-value-highlight {
        background-color: #eaf2fd;
        border-color: #b6d4fe;
        color: #004085;
        font-weight: 700;
    }
</style>

<div class="container-fluid pt-3">

    <!-- Header Principal -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-2 border-bottom">
        <div class="mb-2 mb-md-0">
            <h2 class="font-weight-bold text-dark mb-1" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                <i class="fas fa-file-invoice-dollar text-primary mr-2"></i> Tablero Ejecutivo de Matrículas Adeudadas
            </h2>
            <p class="text-muted mb-0 small">
                Monitoreo consolidado de matrículas con cartera vencida y valores adeudados
            </p>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row mb-4">
        <!-- Total Registros -->
        <div class="col-xl-3 col-md-6 col-sm-12 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #0056b3 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Total Registros</span>
                            <h3 class="mb-0 font-weight-bold text-dark mt-1">@totalMatriculas</h3>
                        </div>
                        <div class="rounded-circle bg-light p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-file-invoice text-primary fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Monto Facturado -->
        <div class="col-xl-3 col-md-6 col-sm-12 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #28a745 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Monto Total Facturado</span>
                            <h3 class="mb-0 font-weight-bold text-success mt-1">$@totalMontoFactura.ToString("N2")</h3>
                        </div>
                        <div class="rounded-circle bg-light p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-dollar-sign text-success fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Saldo Adeudado -->
        <div class="col-xl-3 col-md-6 col-sm-12 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #dc3545 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Total Saldo Adeudado</span>
                            <h3 class="mb-0 font-weight-bold text-danger mt-1">$@totalSaldoAdeudado.ToString("N2")</h3>
                        </div>
                        <div class="rounded-circle bg-light p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-exclamation-circle text-danger fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Compañías Deudoras -->
        <div class="col-xl-3 col-md-6 col-sm-12 mb-3">
            <div class="card card-kpi border-0 shadow-sm bg-white" style="border-left: 4px solid #17a2b8 !important;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Compañías Deudoras</span>
                            <h3 class="mb-0 font-weight-bold text-info mt-1">@totalCompanias</h3>
                        </div>
                        <div class="rounded-circle bg-light p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-building text-info fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Filtro de Búsqueda -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-body p-3">
            @using (Html.BeginForm("ListadoMatriculasAdeudadas", "MatriculasAdeudadas", FormMethod.Post, new { id = "registerForm", enctype = "multipart/form-data" }))
            {
                <div class="row align-items-center">
                    <div class="col-md-3 mb-2 mb-md-0">
                        <label class="font-weight-bold text-muted mb-0 small text-uppercase" style="letter-spacing: 0.5px;">
                            <i class="fas fa-search mr-1 text-primary"></i> Compañía / Matrícula
                        </label>
                    </div>
                    <div class="col-md-7 mb-2 mb-md-0">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-light border-right-0"><i class="fas fa-building text-muted"></i></span>
                            </div>
                            <input type="text" style="text-transform:uppercase" class="form-control border-left-0 pl-0" id="NombreCompania" name="NombreCompania" placeholder="Ingrese nombre de compañía o matrícula..." />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-block rounded-pill shadow-sm font-weight-bold">
                            <i class="fas fa-search mr-1"></i> Buscar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main Table Executive Card -->
    <div class="card border-0 shadow-sm rounded-lg mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="card-title m-0 font-weight-bold text-dark" style="font-size: 1.05rem;">
                <i class="fas fa-list-ul text-primary mr-2"></i> Listado Registrado de Matrículas Adeudadas
            </h5>
            <span class="badge badge-light border px-3 py-2 font-weight-normal" style="border-radius: 20px;">
                <i class="fas fa-layer-group text-primary mr-1"></i> @totalMatriculas Registros
            </span>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="tbDetalle" class="table table-hover table-striped table-executive w-100">
                    <thead>
                        <tr>
                            <th><i class="fas fa-building mr-1"></i> Compañía</th>
                            <th><i class="fas fa-id-card mr-1"></i> RUC</th>
                            <th><i class="fas fa-plane mr-1"></i> Matrícula</th>
                            <th class="text-right"><i class="fas fa-file-invoice-dollar mr-1"></i> Valor Factura</th>
                            <th class="text-right"><i class="fas fa-dollar-sign mr-1"></i> Valor Adeudado</th>
                            <th class="text-center"><i class="fas fa-cogs mr-1"></i> Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="font-weight-bold text-dark">
                                    <i class="fas fa-building text-muted mr-1" style="font-size:0.8rem"></i> @Html.DisplayFor(modelItem => item.COMPAÑIA)
                                </td>
                                <td>
                                    <span class="text-muted font-weight-bold">
                                        @Html.DisplayFor(modelItem => item.RUC)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-light border text-dark font-weight-bold px-2 py-1">
                                        @Html.DisplayFor(modelItem => item.MATRICULA)
                                    </span>
                                </td>
                                <td class="text-right font-weight-bold text-dark">
                                    $@item.VALORFACTURA.ToString("N2")
                                </td>
                                <td class="text-right">
                                    <span class="badge bg-danger text-white badge-pill-custom shadow-sm">
                                        $@item.VALORSALDO.ToString("N2")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary px-3 rounded-pill shadow-sm font-weight-bold" onclick="Consultar(@item.OIDDEUDOR)">
                                        <i class="fas fa-search mr-1"></i> Ver Detalle
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Detalle Ejecutivo -->
    <div class="modal fade" id="largeModal" tabindex="-1" role="dialog" aria-labelledby="largeModal" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title font-weight-bold text-white m-0" id="modalLabel" style="font-size: 1.1rem;">
                        <i class="fas fa-file-invoice text-primary mr-2"></i> Detalle de Matrícula Adeudada
                    </h5>
                    <button type="button" class="close text-white opacity-100" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <div class="card border-0 shadow-sm bg-white mb-0" style="border-radius: 8px;">
                        <div class="card-body p-4">
                            <div class="row">
                                <div class="col-md-8 form-group mb-3">
                                    <label class="detail-label"><i class="fas fa-building mr-1 text-muted"></i> Compañía</label>
                                    <input type="text" class="form-control detail-value font-weight-bold" id="COMPAÑIA" readonly="readonly" />
                                </div>
                                <div class="col-md-4 form-group mb-3">
                                    <label class="detail-label"><i class="fas fa-id-card mr-1 text-muted"></i> RUC</label>
                                    <input type="text" class="form-control detail-value detail-value-highlight" id="RUC" readonly="readonly" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group mb-3">
                                    <label class="detail-label"><i class="fas fa-plane mr-1 text-muted"></i> Matrícula</label>
                                    <input type="text" class="form-control detail-value font-weight-bold text-primary" id="MATRICULA" readonly="readonly" />
                                </div>
                                <div class="col-md-6 form-group mb-3">
                                    <label class="detail-label"><i class="fas fa-hashtag mr-1 text-muted"></i> Número Factura</label>
                                    <input type="text" class="form-control detail-value" id="NUMEROFACTURA" readonly="readonly" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 form-group mb-3">
                                    <label class="detail-label"><i class="fas fa-calendar-alt mr-1 text-muted"></i> Fecha Factura</label>
                                    <input type="text" class="form-control detail-value" id="FECHAFACTURA" readonly="readonly" />
                                </div>
                                <div class="col-md-4 form-group mb-3">
                                    <label class="detail-label"><i class="fas fa-calendar-check mr-1 text-muted"></i> Fecha Recepción</label>
                                    <input type="text" class="form-control detail-value" id="FECHARECEPCION" readonly="readonly" />
                                </div>
                                <div class="col-md-4 form-group mb-3">
                                    <label class="detail-label"><i class="fas fa-calendar-times mr-1 text-muted"></i> Fecha Vencimiento</label>
                                    <input type="text" class="form-control detail-value" id="FECHAVENCIMIENTO" readonly="readonly" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group mb-3">
                                    <label class="detail-label"><i class="fas fa-file-invoice-dollar mr-1 text-muted"></i> Valor Factura</label>
                                    <input type="text" class="form-control detail-value font-weight-bold text-success" id="VALORFACTURA" readonly="readonly" />
                                </div>
                                <div class="col-md-6 form-group mb-3">
                                    <label class="detail-label"><i class="fas fa-dollar-sign mr-1 text-muted"></i> Valor Adeudado</label>
                                    <input type="text" class="form-control detail-value font-weight-bold text-danger" id="VALORADEUDA" readonly="readonly" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white border-top py-2">
                    <button type="button" class="btn btn-secondary px-4 rounded-pill font-weight-bold" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts{
    <script>
        $(document).ready(function () {
            if ($.fn.dataTable.isDataTable('#tbDetalle')) {
                $('#tbDetalle').DataTable().destroy();
            }

            $('#tbDetalle').DataTable({
                "responsive": true,
                "autoWidth": false,
                "pageLength": 10,
                "language": {
                    "sProcessing":     "Procesando...",
                    "sLengthMenu":     "Mostrar _MENU_ registros",
                    "sZeroRecords":    "No se encontraron resultados",
                    "sEmptyTable":     "Ningún dato disponible en esta tabla",
                    "sInfo":           "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                    "sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
                    "sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
                    "sSearch":         "Buscar:",
                    "oPaginate": {
                        "sFirst":    "Primero",
                        "sLast":     "Último",
                        "sNext":     "Siguiente",
                        "sPrevious": "Anterior"
                    }
                }
            });
        });

        function Consultar(Oid) {
            $("#COMPAÑIA").val("");
            $("#RUC").val("");
            $("#MATRICULA").val("");
            $("#NUMEROFACTURA").val("");
            $("#VALORFACTURA").val("");
            $("#VALORADEUDA").val("");
            $("#FECHAFACTURA").val("");
            $("#FECHARECEPCION").val("");
            $("#FECHAVENCIMIENTO").val("");

            $.ajax({
                url: $.MisUrls.url._DetalleMatriculaDeudor,
                type: "GET",
                contentType: "application/json;charset=UTF-8",
                dataType: "json",
                data: { OidMatricula: Oid },
                success: function (e) {
                    $("#COMPAÑIA").val(e.COMPAÑIA);
                    $("#RUC").val(e.RUC);
                    $("#MATRICULA").val(e.MATRICULA);
                    $("#NUMEROFACTURA").val(e.NUMEROFACTURA);
                    $("#VALORFACTURA").val(e.VALORFACTURA != null ? ("$ " + parseFloat(e.VALORFACTURA).toFixed(2)) : "");
                    $("#VALORADEUDA").val(e.VALORSALDO != null ? ("$ " + parseFloat(e.VALORSALDO).toFixed(2)) : "");
                    $("#FECHAFACTURA").val(e.FECHAFACTURA);
                    $("#FECHARECEPCION").val(e.FECHARECEPCION);
                    $("#FECHAVENCIMIENTO").val(e.FECHAVENCIMIENTO);
                },
                error: function (errormessage) {
                    Swal.fire("Mensaje", "Financiero: " + errormessage, "warning");
                }
            });

            $('#largeModal').modal('show');
        }
    </script>
}
